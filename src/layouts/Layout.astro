---
// ============================================================
//  🌍 共享布局 (Shared Layout) — 完整博客模板
//  顶部横幅 + 三栏布局 + 左右侧栏 + 夜间模式 + 全站加载动画。
//  新页面用 <Layout> 包住「中间内容区」即可。
// ============================================================
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import MusicPlayer from "../components/MusicPlayer.astro";
import Live2D from "../components/Live2D.astro";
import Toast from "../components/Toast.astro";
import Icon from "../components/Icon.astro";
import { site, banner, chatBubble, avatarDesc, quotes, socials, siteStart, announcement, runningDays, wordCount } from "../config";
import { sidebarConfig } from "../config";
import { getPosts } from "../lib/posts";

const posts = await getPosts();

// 今日一言：按日期固定选一条（同一天不变，可爱又稳定~♡）
const dayOfYear = Math.floor(Date.now() / 86400000);
const quote = quotes[dayOfYear % quotes.length];
const tags = [...new Set(posts.flatMap((p) => p.tags))];
const categories = [...new Set(posts.map((p) => p.category))];
const stats = [
  { k: "文章", v: String(posts.length) },
  { k: "分类", v: String(categories.length) },
  { k: "标签", v: String(tags.length) },
  { k: "总字数", v: String(posts.reduce((sum, post) => sum + wordCount(post.content || ""), 0)) },
  { k: "跑站时长", v: String(runningDays(siteStart)) },
  { k: "最后更新", v: "今天" },
];
// 🏷️ 标签 / 分类 热度统计（用于侧栏「标签云」「分类计数」~♡）
// 自动算每个标签/分类出现在多少篇文章里，加文章时不用手动更新~♡
const tagCount: Record<string, number> = {};
for (const p of posts) for (const t of (p.tags || [])) tagCount[t] = (tagCount[t] || 0) + 1;
const catCount: Record<string, number> = {};
for (const p of posts) catCount[p.category] = (catCount[p.category] || 0) + 1;
// 最大分类数（给侧栏「分类计数条」定比例用；Max 至少 1，避免除零~♡）
const maxCat = Math.max(1, ...Object.values(catCount));


// 今日一言 和 主题说明：
// 主题配色直接写在 src/styles/global.css 的 :root（亮色）和 html.dark（暗色）里，
// 想换颜色就去改 global.css 顶部的色值即可~♡（config.ts 的 theme/darkTheme 保留作参考）
const sidebarLeft = sidebarConfig.left;
const sidebarRight = sidebarConfig.right;
const { title = site.pageTitle, desc = site.tagline, active = "", wide = false, ogImage, article = false } = Astro.props;
// 默认分享缩略图：没有传入 ogImage 时用站点头像做兜底~♡（对应优化：SEO 三件套 OG 标签）
const defaultOg = ogImage || site.avatar || "/awa.jpg";
const absoluteOgImage = new URL(defaultOg, Astro.site ?? Astro.url).href;

// ============================================================
//  🧩 标准图标（SVG，全站统一不依赖 emoji~♡）
//  导航/工具用线性图标（stroke），品牌链接用品牌 logo（fill）
// ============================================================
const line = (inner: string) =>
  `<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${inner}</svg>`;

const icons = {
  home:    line(`<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>`),
  user:    line(`<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>`),
  heart:   line(`<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>`),
  image:   line(`<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/>`),
  book:    line(`<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`),
  folder:  line(`<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>`),
  search:  line(`<circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>`),
  moon:    line(`<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>`),
  up:      line(`<path d="M12 19V5"/><path d="m5 12 7-7 7 7"/>`),
  sun:     line(`<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>`),
};

// 品牌 logo（fill 式）标准图案~♡
const brand = (inner: string, w = 14) =>
  `<svg viewBox="0 0 24 24" width="${w}" height="${w}" fill="currentColor">${inner}</svg>`;

const brandIcons: Record<string, string> = {
  github:  brand(`<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>`),
  bilibili: brand(`<path d="M17.813 4.653h.854c1.51.054 2.769.578 3.773 1.574 1.004.995 1.524 2.249 1.56 3.76v7.36c-.036 1.51-.556 2.769-1.56 3.773s-2.262 1.524-3.773 1.56H5.333c-1.51-.036-2.769-.556-3.773-1.56S.036 18.858 0 17.347v-7.36c.036-1.511.556-2.765 1.56-3.76 1.004-.996 2.262-1.52 3.773-1.574h.774l-1.174-1.12a1.234 1.234 0 0 1-.373-.906c0-.356.124-.658.373-.907l.027-.027c.267-.249.573-.373.92-.373.347 0 .653.124.92.373L9.653 4.44c.071.071.134.142.187.213h4.267a.836.836 0 0 1 .16-.213l2.853-2.747c.267-.249.573-.373.92-.373.347 0 .662.151.929.4.267.249.391.551.391.907 0 .355-.124.657-.373.906zM5.333 7.24c-.746.018-1.373.276-1.88.773-.506.498-.769 1.129-.786 1.894v7.52c.017.764.28 1.395.786 1.893.507.498 1.134.756 1.88.773h13.334c.746-.017 1.373-.275 1.88-.773.506-.498.769-1.129.786-1.893v-7.52c-.017-.765-.28-1.396-.786-1.894-.507-.497-1.134-.755-1.88-.773zM8 11.107c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c0-.373.129-.689.386-.947.258-.257.574-.386.947-.386zm8 0c.373 0 .684.124.933.373.25.249.383.569.4.96v1.173c-.017.391-.15.711-.4.96-.249.25-.56.374-.933.374s-.684-.125-.933-.374c-.25-.249-.383-.569-.4-.96V12.44c.017-.391.15-.711.4-.96.249-.249.56-.373.933-.373Z"/>`),
  twitter: brand(`<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zM13.05 18.14h1.833L8.28 4.63H6.31l6.74 13.51z"/>`),
  discord: brand(`<path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189z"/>`),
};

// 导航菜单（label 现在只放文字，图标用上面的标准 SVG~♡）
const navItems: { key: string; label: string; href: string; icon: string }[] = [
  { key: "home",    label: "首页",   href: "/",    icon: icons.home },
  { key: "about",   label: "档案",   href: "/about/", icon: icons.user },
  { key: "hobbies", label: "兴趣",   href: "/hobbies/", icon: icons.heart },
  { key: "walls",   label: "壁纸",   href: "/walls/", icon: icons.image },
  { key: "posts",   label: "我的",   href: "/posts/", icon: icons.book },
  { key: "archive", label: "归档",   href: "/archive/", icon: icons.folder },
  { key: "github",  label: "GitHub", href: "https://github.com/Caelux520", icon: brandIcons.github },
  // ---- 对应升级 #5：更多页面（数据都在 src/config.ts~♡）----
  { key: "timeline", label: "时间线", href: "/timeline/", icon: icons.up },
  { key: "skills",   label: "技能",   href: "/skills/",   icon: icons.heart },
  { key: "projects", label: "项目",   href: "/projects/", icon: icons.folder },
  // 【已移除】设备(devices) 页面从导航里删掉了；文件还在，想恢复就取消这行注释~
  // { key: "devices",  label: "设备",   href: "/devices/",  icon: icons.image },
  { key: "ai-tools", label: "AI工具", href: "/ai-tools/", icon: icons.search },
  { key: "friends",  label: "友链",   href: "/friends/",  icon: icons.user },
];

// ============================================================
//  🧭 顶部栏「分区化」配置 —— 参考站风格，分几个区、不堆一起~♡
//  ------------------------------------------------------------
//  结构：
//    ① 直接在顶栏显示的项   → 写进 barOrder（首页最前、GitHub 放最后~♡）
//    ② 收进下拉分区的项     → 定义在 dropdownGroups（当前有「我的▾」「关于▾」两组）
//  顶栏从左到右 = 首页 … 📚我的▾ … 👤关于▾ … 友链 … GitHub …（工具按钮）
//
//  【扩展点】以后想加新页面：
//    1) 在 navItems 里加一行 { key, label, href, icon }（记得配图标~♡）
//    2) 决定它放哪里：
//       · 直接显示 → 在 barOrder 里加一个它的 key（注意摆放顺序~♡）
//       · 收进某下拉 → 把它 key 加进 dropdownGroups 中某个分组的 items 里
//       · 不想出现在导航 → 不加即可（页面文件仍在，可直链访问~♡）
//    3) 想调整顶栏顺序 → 直接改 barOrder 的顺序即可，不用碰模板~♡
//  ============================================================

// —— key → 完整导航项 的便捷查找（供下面反查 label/href/icon~♡）——
const itemByKey = (k: string) => navItems.find((x) => x.key === k);

// —— 下拉「分区」配置：title=顶栏按钮名, groupKey=分区标识, icon=分区图标, items=该分区页面key ——
//  【扩展点】想新增一组下拉 / 调整页面归属，改这里即可~♡
const dropdownGroups = [
  // 👤「档案」：个人介绍类（档案/时间线/技能/项目）~♡
  { groupKey: "about", title: "档案", icon: icons.user,   items: ["about", "timeline", "skills", "projects"] },
  // 📚「我的」：内容类（我的/归档/兴趣/壁纸）~♡
  { groupKey: "my",    title: "我的", icon: icons.book,   items: ["posts", "archive", "hobbies", "walls"] },
  // 📦「其他」：杂项收纳（AI工具/友链）~♡
  { groupKey: "other", title: "其他", icon: icons.folder, items: ["ai-tools", "friends"] },
];

// 把每个下拉分区的 key 反查成完整导航项，模板直接用~♡
const dropdownNav = dropdownGroups.map((g) => ({
  ...g,
  nav: g.items.map(itemByKey).filter((n): n is (typeof navItems)[number] => n !== undefined), // 过滤掉 key 写错/已删的项，安全~♡
}));

// —— 顶栏整体显示顺序：直接项写它的 key；下拉分区写它的 groupKey——
//  【扩展点】想换顶栏顺序/加项，只改这里这一行即可~♡
//  现在是：首页 → 档案▾ → 我的▾ → 其他▾ → GitHub（GitHub 在最后~♡）
const barOrder = ["home", "about", "my", "other", "github"];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <!-- viewport-fit=cover：让 iPhone 的刘海/底部小横条区域能被 CSS 感知，
         否则 global.css 里那些 env(safe-area-inset-*) 永远是 0~♡ -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={desc} />
    <!-- 🌈 移动端浏览器地址栏配色（跟随亮/暗主题，切换时由下面脚本同步改）~♡ -->
    <meta name="theme-color" content="#e0c3fc" id="theme-color" />
    <title>{title}</title>
    <!-- 🌙 关键：在【首帧之前】就把 dark 类打上。
         主题脚本原本在 </body> 前才跑，深色用户会先闪一下白底（FOUC）~♡ -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "dark") {
            document.documentElement.classList.add("dark");
            var m = document.getElementById("theme-color");
            // 这时 meta 可能还没解析到，兜底等到下面再改也没关系（applyTheme 会再同步一次）
            if (m) m.setAttribute("content", "#14102b");
          }
        } catch (e) {}
      })();
    </script>
    <!-- 📱 SEO / 分享标签（对应优化「SEO 三件套」）：让分享链接更美观、方便搜索引擎收录~♡
         站点图片/域名来自 astro.config.mjs 的 site 与 public 里的头像~♡ -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- 🖼️ Open Graph（Facebook/微信/QQ 等分享卡片） -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={absoluteOgImage} />
    {article && <meta property="article:published_time" content={article} />}

    <!-- 🐦 Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <!-- 启用 View Transitions：切页不再整页重载，让音乐播放器（transition:persist）跨页不断歌~♡ -->
    <ClientRouter />
    <!-- 注入主题变量：默认亮色 :root，切到 html.dark 用暗色（用 {@html} 才能让 config 的颜色生效~♡） -->
    <!-- 主题变量已经写在 global.css 的 :root / html.dark 里了，颜色和暗色模式都能正常生效~♡ -->
  </head>
  <body>
    <!-- 背景特效层 -->
    <!-- 背景特效层：花瓣放最前，配合 global.css 的 .petal:nth-child(1~8) 定位~♡
         8 片花瓣在不同位置依次飘落；以后增减花瓣数时，记得同步 global.css~♡ -->
    <div class="petal"></div><div class="petal"></div><div class="petal"></div><div class="petal"></div>
    <div class="petal"></div><div class="petal"></div><div class="petal"></div><div class="petal"></div>
    <div class="glow g1"></div><div class="glow g2"></div><div class="stars"></div>

    <!-- 🖼️ 顶部横幅 + 导航 -->
    <header class="banner">
      {banner.img ? <img src={banner.img} alt="" /> : null}
      <nav class="nav">
        <!-- 🌸 品牌 logo：用 sakura 樱花标准 SVG（不再是 emoji~♡）
             想换图标/颜色：改下面 svg 的 fill（当前随文字色自适应亮/暗~♡） -->
        <a class="brand" href="/">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" class="b-ic"
               aria-hidden="true"><path d="M12 21c-1.5-3-1.5-5.5 0-8 1.5 2.5 1.5 5 0 8zM12 21c-3.5-2-5.5-3.8-6.5-6.5 3-.5 5.3.4 6.5 2.5zM12 21c3.5-2 5.5-3.8 6.5-6.5-3-.5-5.3.4-6.5 2.5zM12 13c-2-2.5-3.5-4.8-4-7.5 3 1 5 3 4 7.5zM12 13c2-2.5 3.5-4.8 4-7.5-3 1-5 3-4 7.5z"/></svg>
          {site.name}の部屋</a>
        <div class="links">
          <!-- 顶栏按 barOrder 顺序渲染：直接项显示链接，下拉分区显示「▾」按钮~♡ -->
          {barOrder.map((entry) => {
            // ① 先看是不是「下拉分区」（barOrder 里写的是它的 groupKey）~♡
            const g = dropdownNav.find((d) => d.groupKey === entry);
            if (g) {
              return (
                <div class="nav-drop">
                  <button type="button" class="drop-btn" aria-haspopup="true" aria-expanded="false">
                    <span class="n-ic" set:html={g.icon}></span>{g.title}<span class="caret">▾</span>
                  </button>
                  <div class="drop-menu" role="menu">
                    <div class="drop-title">{g.title} ▾</div>
                    {g.nav.map((n) => (
                      <a href={n.href} class:list={[{ active: active === n.key }]} role="menuitem"
                         target={n.href.startsWith("http") ? "_blank" : undefined}>
                        <span class="n-ic" set:html={n.icon}></span>{n.label}
                      </a>
                    ))}
                  </div>
                </div>
              );
            }
            // ② 否则是「直接显示项」（如首页 / 友链 / GitHub~♡）
            const n = itemByKey(entry);
            if (!n) return null;   // key 写错/已被删 → 安全跳过~♡
            return (
              <a href={n.href} class:list={[{ active: active === n.key }]}
                 target={n.href.startsWith("http") ? "_blank" : undefined}
                 rel={n.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                <span class="n-ic" set:html={n.icon}></span>{n.label}
              </a>
            );
          })}
        </div>
        <div class="tools">
          <!-- 🔍 搜索横条：鼠标悬停放大镜 / 点击放大镜 → 横条滑出可直接输入~♡
               结果在下方 .search-drop 下拉展示；输入框聚焦或悬停时保持展开~♡
               【扩展点】想调横条宽度/展开动画 → 改 global.css 的 .search-wrap / .search-box~♡ -->
          <div class="search-wrap">
            <div class="search-box" id="search-box">
              <input id="search-input" type="text" placeholder="搜文章标题 / 分类 / 标签…~♡" autocomplete="off" />
              <div class="search-drop" id="search-body"></div>
            </div>
            <button id="btn-search" title="搜索" aria-label="搜索" set:html={icons.search}></button>
          </div>
          <button id="btn-theme" title="切换夜间模式" aria-label="切换夜间模式" set:html={icons.moon}></button>
          <!-- 📱 手机端汉堡键（≤640px 才显示）：点开右侧抽屉导航~♡
               桌面端由 global.css 的 .nav .nav-burger { display:none } 隐藏~♡ -->
          <button id="btn-menu" class="nav-burger" title="菜单" aria-label="打开导航菜单" aria-expanded="false" aria-controls="m-drawer">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </nav>
    </header>

    <!-- 📱 手机端抽屉导航（参考 Mizuki：顶栏只留品牌+工具键，其余收进抽屉~♡）
         结构：遮罩 .m-mask + 右侧面板 .m-drawer；内容按 barOrder 与顶栏完全一致，
         所以以后改 barOrder / dropdownGroups，桌面顶栏和手机抽屉会同步变化~♡ -->
    <div class="m-mask" id="m-mask"></div>
    <aside class="m-drawer" id="m-drawer" role="dialog" aria-modal="true" aria-label="站点导航" aria-hidden="true">
      <div class="m-drawer-head">
        <span class="m-drawer-brand">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 21c-1.5-3-1.5-5.5 0-8 1.5 2.5 1.5 5 0 8zM12 21c-3.5-2-5.5-3.8-6.5-6.5 3-.5 5.3.4 6.5 2.5zM12 21c3.5-2 5.5-3.8 6.5-6.5-3-.5-5.3.4-6.5 2.5zM12 13c-2-2.5-3.5-4.8-4-7.5 3 1 5 3 4 7.5zM12 13c2-2.5 3.5-4.8 4-7.5-3 1-5 3-4 7.5z"/></svg>
          {site.name}の部屋
        </span>
        <button class="m-drawer-close" id="m-drawer-close" title="关闭菜单" aria-label="关闭菜单">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <nav class="m-drawer-body">
        <!-- 🔍 抽屉里的搜索入口：抽屉打开时顶栏的放大镜被遮罩挡住点不到，
             这里给一个直达的；点它会自动收起抽屉再展开搜索~♡ -->
        <div class="m-quick">
          <button type="button" class="m-action" id="m-search-btn">
            <span class="n-ic" set:html={icons.search}></span>搜索文章
          </button>
        </div>
        {barOrder.map((entry) => {
          const g = dropdownNav.find((d) => d.groupKey === entry);
          if (g) {
            return (
              <div class="m-group">
                <div class="m-group-t">{g.title}</div>
                {g.nav.map((n) => (
                  <a class:list={["m-link", { active: active === n.key }]} href={n.href}
                     target={n.href.startsWith("http") ? "_blank" : undefined}
                     rel={n.href.startsWith("http") ? "noopener noreferrer" : undefined}>
                    <span class="n-ic" set:html={n.icon}></span>{n.label}
                  </a>
                ))}
              </div>
            );
          }
          const n = itemByKey(entry);
          if (!n) return null;
          return (
            <a class:list={["m-link", { active: active === n.key }]} href={n.href}
               target={n.href.startsWith("http") ? "_blank" : undefined}
               rel={n.href.startsWith("http") ? "noopener noreferrer" : undefined}>
              <span class="n-ic" set:html={n.icon}></span>{n.label}
            </a>
          );
        })}
      </nav>
    </aside>

    <!-- 📄 三栏主布局 -->
    <div class:list={["layout", { wide: wide }]}>
          <!-- 💬 左侧栏：按 sidebarConfig.left 顺序渲染（对应升级 #12~♡） -->
    <aside class="side">
      {sidebarLeft.map((key) => {
        if (key === "profile") return (
          <div class="card profile">
            <div class="bubble">{chatBubble}</div>
            <img class="avatar" src={site.avatar} alt="头像" />
            <div class="sname">{site.name}</div>
            {site.alias && <div class="salias">{site.alias}</div>}
            <p class="stext">{avatarDesc}</p>
          </div>
        );
        if (key === "quote") return (
          <div class="card quote-card">
            <div class="sec-title" style="margin:0 0 6px;">今日一言</div>
            <p class="quote">“{quote}”</p>
          </div>
        );
        if (key === "socials") return (
          <div class="card">
            <div class="sec-title" style="margin:0 0 8px;">社交链接</div>
            <div class="socials">
              {/* 配置见 src/config/site.ts：
                  有 url  → 正常跳转（新标签页）
                  没 url  → 渲染成「还没开放」按钮，点了在顶部弹提示、不跳转~♡
                  （data-toast 由全站统一的 Toast 组件接管，见 src/lib/toast.ts） */}
              {socials.map((s) =>
                s.url ? (
                  <a class="social" href={s.url} target="_blank" rel="noopener noreferrer">
                    <span class="sic" set:html={brandIcons[s.icon]}></span>{s.name}
                  </a>
                ) : (
                  <button
                    type="button"
                    class="social is-soon"
                    data-toast={s.soon || `${s.name} 还没弄好哦~ 敬请期待~♡`}
                  >
                    <span class="sic" set:html={brandIcons[s.icon]}></span>{s.name}
                  </button>
                )
              )}
            </div>
          </div>
        );
        return null;
      })}
    </aside>

      <!-- 📖 中间内容区 -->
      <!-- tabindex="-1"：只为了让脚本能在切页后把焦点放回正文（配合 Layout 尾部的 onPageLoad）~♡ -->
      <main class="main" id="main" tabindex="-1">
        <slot />
      </main>

          <!-- 📊 右侧栏：按 sidebarConfig.right 顺序渲染（对应升级 #12~♡） -->
    <aside class="side">
      {sidebarRight.map((key) => {
        if (key === "announcement") return announcement ? (
          <div class="card announce">
            <div class="sec-title" style="margin:0 0 6px;"><Icon name="announce" size={16} />&nbsp;公告</div>
            <p class="announce-text">{announcement}</p>
          </div>
        ) : null;
        if (key === "stats") return (
          <div class="card">
            <div class="sec-title" style="margin:0 0 6px;">站点统计</div>
            {stats.map((s) => (
              <div class="stat-item"><span class="k">{s.k}</span>{s.k === '跑站时长' ? <span class="v" id="uptime">{s.v}</span> : <span class="v">{s.v}</span>}</div>
            ))}
          </div>
        );
        if (key === "tags") return (
          <div class="card">
            <div class="sec-title" style="margin:0 0 10px;">标签 <span class="hint">(用得多显示得大~♡)</span></div>
            <div class="tag-list tag-cloud">
              {tags.map((t) => {
                const c = tagCount[t] || 0;
                const wt = c >= 3 ? "w3" : c === 2 ? "w2" : c === 1 ? "w1" : "w0";
                return (
                  <a class:list={[`w-${wt}`]} href={`/archive/?tag=${encodeURIComponent(t)}`}>{t}
                    {c > 0 && <span class="tag-n">{c}</span>}
                  </a>
                );
              })}
            </div>
          </div>
        );
        if (key === "categories") return (
          <div class="card">
            <div class="sec-title" style="margin:0 0 10px;">分类</div>
            <div class="cat-list">
              {categories.map((c) => (
                <div class="cat-item">
                  <a href={`/archive/?category=${encodeURIComponent(c)}`}>{c}
                    {catCount[c] ? <span class="cat-n">{catCount[c]}</span> : null}
                  </a>
                  <span class="cat-bar"><i style={`width:${Math.round((catCount[c] || 0) / maxCat * 100)}%`}></i></span>
                </div>
              ))}
            </div>
          </div>
        );
        return null;
      })}
    </aside>
    </div>

    <footer class="footer">
      © {new Date().getFullYear()} {site.name} · Made with
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px;color:var(--accent)" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      and
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><path d="M6 1v3M10 1v3M14 1v3"/></svg>
      · いんしゅん の部屋
    </footer>

    <!-- 🎵 全局音乐播放器（迷你条 + 展开卡，常驻底部~♡） -->
    <MusicPlayer />

    <!-- 🎀 Live2D 桌宠（贴右下角，在音乐条上方；换模型只改 src/config/live2d.ts~♡） -->
    <Live2D />

    <!-- 🔔 全站小提示窗（社交链接「还没做」之类的轻提示都走它；
         用法见 src/lib/toast.ts，想加新配色改 Toast.astro 底部 CSS~♡） -->
    <Toast />

    <!-- 🔍 站内搜索弹层（对应优化⑥：从占位 alert 升级成真搜索~♡） -->
    <!-- 🔍 搜索：已从「居中弹层」改成「顶栏悬停横条」式~♡
         搜索框 + 结果下拉都内置在顶部导航栏的 .tools（.search-wrap）里，
         鼠标悬停/点放大镜 → 横条滑出直接搜；结果以下拉列表展示~♡
         （样式在 global.css 的 .search-wrap 段；逻辑在尾部 search 脚本~♡） -->

    <!-- 🔝 返回顶部按钮 -->
    <button class="tool-top" id="tool-top" title="回到顶部" aria-label="回到顶部" set:html={icons.up}></button>

    <!-- ⏳ 全站加载动画（所有页面共用；点链接先显示它，页面就绪后淡出） -->
    <div class="loader" id="loader">
      <!-- 🌀 加载球：sakura 樱花 SVG（原 emoji 🌸 换掉了~♡），颜色随主题 accent~♡ -->
      <div class="spin"><svg viewBox="0 0 24 24" width="40" height="40" fill="var(--accent)" aria-hidden="true"><path d="M12 21c-1.5-3-1.5-5.5 0-8 1.5 2.5 1.5 5 0 8zM12 21c-3.5-2-5.5-3.8-6.5-6.5 3-.5 5.3.4 6.5 2.5zM12 21c3.5-2 5.5-3.8 6.5-6.5-3-.5-5.3.4-6.5 2.5zM12 13c-2-2.5-3.5-4.8-4-7.5 3 1 5 3 4 7.5zM12 13c2-2.5 3.5-4.8 4-7.5-3 1-5 3-4 7.5z"/></svg></div>
      <p class="txt">正在加载中…~♡</p>
      <div class="bar"><i></i></div>
    </div>

    <script is:inline>
      (function () {
        var html = document.documentElement;
        html.classList.add("js"); // 标记 JS 可用，浮现动画才生效~♡

        // ============================================================
        //  🌙 主题切换（全站共用一个逻辑）
        //  【关键点】is:inline 脚本在 SPA 切页时【不会重新执行】，
        //  所以「应用保存的主题」和「重新绑定按钮」必须放进 astro:page-load
        //  （这个事件切页都会派发），否则会出现：
        //    · 切页后深色被强制切回浅色（没重新套用 localStorage）
        //    · 切回页面后顶栏深色按钮失灵（新按钮没绑定监听）
        //  按钮统一用 onXxx 覆盖式绑定（而非 addEventListener），
        //  反复调用也不会重复触发~♡
        // ============================================================
        var sunSvg = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>';
        var moonSvg = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';

        // 🌈 让浏览器地址栏颜色跟着主题走（安卓 Chrome / iOS Safari 15+ 都会用~♡）
        function syncThemeColor() {
          var m = document.getElementById("theme-color");
          if (m) m.setAttribute("content", html.classList.contains("dark") ? "#14102b" : "#e0c3fc");
        }
        // 从 localStorage 套用主题到 <html>（每次切页都重跑，保证深色不会被冲掉~♡）
        function applyTheme() {
          var saved = localStorage.getItem("theme");
          if (saved === "dark") html.classList.add("dark");
          else html.classList.remove("dark");
          syncThemeColor();
        }
        function paintTheme(btn) {
          if (btn) btn.innerHTML = html.classList.contains("dark") ? sunSvg : moonSvg;
        }

        // 🌙 主题切换动画辅助：盖一层柔光"洗屏"再散开，让换色不硬切~♡
        var themeWashEl = null;
        // 🌙 覆盖层底色 = 「目标主题」的页面背景渐变（从左到右铺开的颜色）~♡
        //  💡 扩展点：想换配色 → 改 global.css 的 :root / html.dark 时，
        //     顺手把下面这两行的渐变同步一下即可~♡
        var TW_LIGHT = "linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)";
        var TW_DARK  = "linear-gradient(135deg, #14102b 0%, #0a0817 100%)";
        function themeWash(toDark) {
          // 修复「切页后深色动画消失」：View Transitions 时旧遮罩 div 会随页面被移除，
          // 但本 is:inline 脚本不重跑，themeWashEl 仍指着已脱离文档的旧元素 → 动画失效。
          // 用 isConnected 判断元素是否还在文档里，不在就重建一个新的~♡
          if (!themeWashEl || !themeWashEl.isConnected) {
            themeWashEl = document.createElement("div");
            themeWashEl.className = "theme-wash";
            document.body.appendChild(themeWashEl);
          }
          // 覆盖层用「目标主题」的颜色，从左到右铺开（此刻 html 还没切，
          // 底部仍是旧主题，所以能看到深/浅色从左边一步步覆盖到右边~♡）
          themeWashEl.style.background = toDark ? TW_DARK : TW_LIGHT;
          themeWashEl.style.opacity = "1";
          themeWashEl.classList.remove("go");
          void themeWashEl.offsetWidth; // 强制回流，确保每次都能重播~♡
          themeWashEl.classList.add("go");
        }
        // 移除覆盖层（动画铺满后调用，露出已切换的新背景~♡）
        function removeThemeWash() {
          if (themeWashEl && themeWashEl.parentNode) {
            themeWashEl.parentNode.removeChild(themeWashEl);
          }
          themeWashEl = null;
        }

        // ============================================================
        //  📱 手机端抽屉菜单（开/合 + 锁滚动 + aria 同步）
        //  · 元素每次切页都会换新，所以这里只按 id 现查，不缓存~
        //  · open=true 时锁住 body 滚动，避免抽屉后面还能滑页面~♡
        // ============================================================
        // ♿ 抽屉打开时把「背后那一整页」设成 inert：
        //    · 视觉上被遮罩盖住，但键盘 Tab / 读屏其实还能摸到 → 这里直接掐掉
        //    · 只保留抽屉和遮罩本身可交互，关闭时逐个还原
        function setPageInert(on) {
          var kids = document.body.children;
          for (var i = 0; i < kids.length; i++) {
            var el = kids[i];
            if (!el || el.nodeType !== 1) continue;
            if (el.id === "m-drawer" || el.id === "m-mask") continue;   // 抽屉自己 + 遮罩要能用
            if (el.tagName === "SCRIPT" || el.tagName === "ASTRO-DEV-TOOLBAR") continue;
            if (on) el.setAttribute("inert", "");
            else el.removeAttribute("inert");
          }
        }

        // keepFocus：切页时调用（此时焦点会被换页丢掉，别再去抢回来）
        function setMenu(open, keepFocus) {
          var drawer = document.getElementById("m-drawer");
          var mask = document.getElementById("m-mask");
          var burger = document.getElementById("btn-menu");
          if (drawer) {
            drawer.classList.toggle("open", open);
            drawer.setAttribute("aria-hidden", open ? "false" : "true");
          }
          if (mask) mask.classList.toggle("open", open);
          if (burger) {
            burger.classList.toggle("on", open);
            burger.setAttribute("aria-expanded", open ? "true" : "false");
            burger.setAttribute("aria-label", open ? "关闭导航菜单" : "打开导航菜单");
          }
          document.body.classList.toggle("menu-open", open);
          setPageInert(open);

          if (open) {
            // 焦点移进抽屉：键盘用户不会一 Tab 就掉到背后的页面上~♡
            var closeBtn = document.getElementById("m-drawer-close");
            if (closeBtn) setTimeout(function () { try { closeBtn.focus(); } catch (e) {} }, 60);
          } else if (!keepFocus && drawer && drawer.contains(document.activeElement) && burger) {
            // 用关闭键 / Esc / 遮罩关掉时，把焦点还给汉堡键，别让它掉到 body 上~♡
            try { burger.focus(); } catch (e) {}
          }
        }

        // 重新绑定顶部工具按钮 + 回顶按钮（切页后是新 DOM，必须每次重绑~♡）
        function bindUI() {
          var bTheme = document.getElementById("btn-theme");
          if (bTheme) {
            paintTheme(bTheme);
            bTheme.onclick = function () {
              // 目标主题 = 当前的反面（先不切换，等覆盖层铺满后再切~♡）
              var toDark = !html.classList.contains("dark");
              // 🌙 图标旋转反馈~♡
              bTheme.classList.remove("turning");
              void bTheme.offsetWidth; // 强制回流重播旋转~♡
              bTheme.classList.add("turning");

              // 1) 先让「目标主题」从左到右铺满屏幕（此刻底部还是旧主题，
              //    所以能看到深/浅色从左往右覆盖的完整过程~♡）
              themeWash(toDark);
              // 2) 真正切换主题放在「覆盖层铺满」的瞬间（≈动画70% ≈ .7s×0.7≈500ms），
              //    此刻后段淡出尚未开始，底景先变暗与覆盖层同色 → 全程无缝~♡
              //    💡 想调快/慢：这数值要与 global.css 的动画时长(.7s)联动，
              //       铺满点 ≈ 总时长 × 0.7~♡
              setTimeout(function () {
                html.classList.toggle("dark", toDark);
                localStorage.setItem("theme", toDark ? "dark" : "light");
                paintTheme(bTheme);
                syncThemeColor();
              }, 500);
              // 3) 动画整体结束后再移除覆盖层，让末尾淡出自然露出新背景~♡
              setTimeout(removeThemeWash, 760); // ≈ 动画总时长(.7s)+余量
            };
          }
          // 📱 手机端汉堡键 / 关闭键 / 遮罩（每次切页重新绑定新 DOM~♡）
          var bMenu = document.getElementById("btn-menu");
          if (bMenu) bMenu.onclick = function (e) {
            e.preventDefault();
            var drawer = document.getElementById("m-drawer");
            setMenu(!(drawer && drawer.classList.contains("open")));
          };
          var mClose = document.getElementById("m-drawer-close");
          if (mClose) mClose.onclick = function () { setMenu(false); };
          // 🔍 抽屉里的「搜索文章」：先收抽屉，等遮罩淡出后再触发顶栏的搜索键~♡
          //    （复用 #btn-search 的点击逻辑，搜索那边以后怎么改这里都不用跟~♡）
          var mSearchBtn = document.getElementById("m-search-btn");
          if (mSearchBtn) mSearchBtn.onclick = function () {
            setMenu(false);
            setTimeout(function () {
              var b = document.getElementById("btn-search");
              if (b) b.click();
            }, 280);
          };
          var mMask = document.getElementById("m-mask");
          if (mMask) mMask.onclick = function () { setMenu(false); };
          // 点抽屉里的链接 → 先收起抽屉再走跳转，避免切页瞬间还挂着~♡
          var mDrawerEl = document.getElementById("m-drawer");
          if (mDrawerEl) {
            Array.prototype.forEach.call(mDrawerEl.querySelectorAll("a"), function (a) {
              a.onclick = function () { setMenu(false); };
            });
          }

          // 🔍 搜索：真正的搜索逻辑在尾部 search 脚本里（bind 已随 astro:page-load 重绑），
          //    这里不再挂占位 alert（之前就是它每次切页后把真搜索覆盖掉，导致失灵~♡）
          //    （注：本 bindUI 是 is:inline 脚本，切页不重跑；搜索由 define:vars 脚本负责重绑~♡）

          // 🧭 顶栏下拉（「我的▾」「关于▾」等）：桌面靠 CSS 悬停展开，
          // 这里用一个全局 click 监听补「点击切换 + 点外部关闭」，
          // 让触屏/小屏（没有悬停）也能用~♡ 用标记只注册一次~♡
          if (!window.__dropInit) {
            window.__dropInit = true;
            // 辅助：同步某个下拉按钮的 aria-expanded~♡
            function setDropAria(dd, open) {
              var b = dd.querySelector(".drop-btn");
              if (b) b.setAttribute("aria-expanded", open ? "true" : "false");
            }
            document.addEventListener("click", function (e) {
              var t = e.target;
              var opens = document.querySelectorAll(".nav-drop.open");
              var btn = t.closest && t.closest(".drop-btn");
              if (btn) {
                // 点的是某个下拉按钮 → 切换它，并顺手收起别的~♡
                var dd = btn.closest(".nav-drop");
                var goOpen = !dd.classList.contains("open");
                opens.forEach(function (o) { if (o !== dd) { o.classList.remove("open"); setDropAria(o, false); } });
                dd.classList.toggle("open", goOpen);
                btn.setAttribute("aria-expanded", goOpen ? "true" : "false");
              } else {
                // 点的是下拉外面 → 全部收起~♡
                opens.forEach(function (o) { o.classList.remove("open"); setDropAria(o, false); });
              }
            });

            // 🐭 下拉「鼠标移开自动收回」修复~♡（委托监听，切页也不用重绑~♡）
            // 之前的问题：点击撑开 `.open` 后，鼠标挪开【不会】收回（只有点空白才关）~
            // 解决：用 document 上的 mouseover 实时记录「当前悬停在哪个 .nav-drop 上」，
            //       一旦离开任意下拉（悬停到别的 / 悬停到外面），就把上一个
            //       （包括被点击撑开的那个）一并收回~♡
            // 💡 这样「悬停进出」和「点击开合」两套都顺：
            //       悬停 → 自然开合；点开 → 挪开鼠标也会自己收起~♡
            var hoverDrop = null;
            document.addEventListener("mouseover", function (e) {
              var t = e.target;
              var dd = t && t.closest ? t.closest(".nav-drop") : null;
              if (dd !== hoverDrop) {
                if (hoverDrop) { hoverDrop.classList.remove("open"); setDropAria(hoverDrop, false); }
                hoverDrop = dd;
              }
            });

            // 📱 竖屏触屏优化：一旦滚动页面，就自动收起所有打开的下拉面板~♡
            //   （窄屏里下拉是 fixed 全宽面板，若一直悬着会遮挡正文；
            //     滚动一发生就收回，浏览更顺畅~♡）
            window.addEventListener("scroll", function () {
              var opens = document.querySelectorAll(".nav-drop.open");
              opens.forEach(function (o) { o.classList.remove("open"); setDropAria(o, false); });
            }, { passive: true });

            // ⌨️ 键盘可达性（对应优化：无障碍~♡）：Enter/空格 开合下拉，Esc 全关~♡
            document.addEventListener("keydown", function (e) {
              var t = e.target;
              var btn = t && t.closest ? t.closest(".drop-btn") : null;
              if (btn) {
                if (e.key === "Enter" || e.key === " ") {
                  e.preventDefault();
                  var dd = btn.closest(".nav-drop");
                  var goOpen = !dd.classList.contains("open");
                  var opens = document.querySelectorAll(".nav-drop.open");
                  opens.forEach(function (o) { if (o !== dd) { o.classList.remove("open"); setDropAria(o, false); } });
                  dd.classList.toggle("open", goOpen);
                  btn.setAttribute("aria-expanded", goOpen ? "true" : "false");
                  if (goOpen) { var first = dd.querySelector(".drop-menu a"); if (first) first.focus(); }
                }
              } else if (e.key === "Escape") {
                var opens = document.querySelectorAll(".nav-drop.open");
                opens.forEach(function (o) { o.classList.remove("open"); setDropAria(o, false); });
                setMenu(false);   // 📱 Esc 也顺手收起手机抽屉~♡
              }
            });
          }

          var toolTop = document.getElementById("tool-top");
          if (toolTop) toolTop.onclick = function () { window.scrollTo({ top: 0, behavior: "smooth" }); };
          paintTop();
        }

        // 🔝 滚动：导航吸顶收放 + 回顶按钮（window 监听只注册一次，读取当前 DOM~♡）
        // 💡 改了逻辑：之前是「往上轻轻一滑就冒出来」，
        //    现在改成「【只有滚回顶部附近】顶栏才重新出现」（往下滚立刻收起，
        //    往上滚但没回到顶部 → 保持收起，不早跳出来~♡）
        var prevY = window.scrollY;
        var topShown = 80;   // 回到「距顶部多少 px 以内」算“到顶” → 顶栏才出现~♡
                             // 💡 想更严格/宽松就改这个数值（越小=越要滚回更顶才出现）~♡
        function paintTop() {
          var toolTop = document.getElementById("tool-top");
          if (toolTop) toolTop.classList.toggle("show", window.scrollY > 300);
          var nav = document.querySelector(".banner .nav");
          var y = window.scrollY;
          if (nav) {
            if (y <= topShown) {      // 🏠 回到顶部附近 → 才重新显示顶栏~♡
              nav.classList.remove("hide");
            } else if (y > prevY) {   // ⬇️ 往下滚 → 立刻收起~♡
              nav.classList.add("hide");
            }
            // 往上滚但还没回到顶部 → 保持收起，不提前冒出来~♡
          }
          prevY = y;
        }
        window.addEventListener("scroll", paintTop);

        // ✨ 进场浮现：首次进入从这里跑，切页用 replayReveal 重播~♡
        var revealSel = '.layout .main .card, .layout .main .post-card, .layout .main .sec, .layout .main .filter, .layout .main .post-body';
        var revealSideSel = '.layout .side .card';
        function replayReveal() {
          var main = document.querySelectorAll(revealSel);
          var side = document.querySelectorAll(revealSideSel);
          // 只需给每个元素设置 animation-delay：
          // 新挂载的元素本身会自动播放 xi-rise 动画，无需删/加类~♡
          // 💡 可调参数：0.22=主区起步, 0.10=主区每项间隔；
          //             0.40=侧栏起步, 0.08=侧栏每项间隔（想更快/更明显改这两组 ~♡）
          // 💡 延迟封顶：只在窄屏生效（手机上文章多时，别让最后一张等 1.6s 才浮现）~♡
          var delayCap = window.innerWidth <= 768 ? 8 : 1e9;
          main.forEach(function (el, i) { el.style.animationDelay = (0.22 + Math.min(i, delayCap) * 0.10) + 's'; });
          side.forEach(function (el, i) { el.style.animationDelay = (0.40 + (i % 4) * 0.08) + 's'; });
        }

        // ⏳ 视图切换 / 统一收尾 —— 只注册一次、切页都会触发~♡
        var navCount = 0;
        function onPageLoad() {
          navCount++;
          setMenu(false, true);   // 📱 切页后抽屉一律收起（滚动锁/inert 一并还原，且不抢焦点）~♡
          // ♿ 切页后浏览器会把焦点丢在 body 上（屏幕阅读器就「不知道自己在哪」了）。
          //    把焦点还给正文容器，读屏会从新页面内容开始念；视觉上不加描边~♡
          var mainEl = document.getElementById("main");
          if (mainEl && (document.activeElement === document.body || !document.activeElement)) {
            try { mainEl.focus({ preventScroll: true }); } catch (e) {}
          }
          html.classList.add("js"); // 补一次 js 标记，保证浮现 CSS 生效~♡
          // 1) 重新套用主题 + 重新绑定按钮（修复切回页面按钮失灵 & 深色被冲掉~♡）
          applyTheme();
          bindUI();
          // 2) 切页：让加载画面先罩住一小会（模仿「先加载后跳转」的质感），
          //    再统一收掉 + 重播缓出；首次由下方 load 事件带淡出节奏~♡
          if (navCount > 1) {
            // 💡 这里只留一帧的缓冲（以前是 250ms 的人为等待，手机上纯属拖慢）~♡
            //    淡出本身还有 CSS 过渡，观感依然是一层柔和收尾。
            setTimeout(function () {
              var l = document.getElementById("loader");
              if (l) l.classList.add("done");
              replayReveal();
            }, 60);
          }
        }
        document.addEventListener("astro:page-load", onPageLoad);
        // 切页「开始」时就收起抽屉：View Transition 会拍快照，晚收会在新页闪一下~♡
        document.addEventListener("astro:before-swap", function () { setMenu(false, true); });

        // 📐 兜底：抽屉开着时把窗口拉宽成桌面（或手机横屏），抽屉会被 media query 隐藏，
        //    但 inert 还留在页面上 → 整页会「点不动」。宽度一超过 768 就强制收起~♡
        window.addEventListener("resize", function () {
          if (window.innerWidth > 768) setMenu(false, true);
        });

        // ⏱ 加载层「看门狗」：万一某次切页没成功（网络断了 / 脚本报错 / 路由抛异常），
        //    加载层会一直盖在页面上，表现就是「整页点不动、像卡死」。
        //    这里 3 秒兜底强制收掉它 —— 宁可少一段动画，也不能让页面变砖~♡
        var loaderWatchdog = null;
        function armLoaderWatchdog() {
          if (loaderWatchdog) clearTimeout(loaderWatchdog);
          loaderWatchdog = setTimeout(function () {
            var el = document.getElementById("loader");
            if (el) el.classList.add("done");
          }, 3000);
        }

        // 🚪 站内链接切页：点击时先让加载画面罩住（跟参考版「先加载后跳转」一致~♡）
        //  用 document 事件委托（只注册一次），每次切页后的新链接也能命中~♡
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          if (!a) return;
          var href = a.getAttribute("href") || "";
          if (!href || href.startsWith("http") ||
              a.getAttribute("target") === "_blank" ||
              href.startsWith("#")) return;
          var l = document.getElementById("loader");
          if (l) l.classList.remove("done"); // 揭开"暂停态"→ loader 淡入罩住~♡
          armLoaderWatchdog();               // 配套看门狗：这次切页超时就自动放行~♡
        });

        // ---- 首次进入专用：初始化 + 进场浮现 + 加载画面淡出 ----
        armLoaderWatchdog();   // 首次加载也兜底（万一 hideLoader 因为异常没执行到）~♡
        applyTheme();
        bindUI();
        replayReveal(); // 首次进场交错缓出~♡
        var loader = document.getElementById("loader");
        function hideLoader() { loader.classList.add("done"); }
        // 💡 首次进站也别干等：以前 400ms，现在 150ms（再慢就只剩观感损失了）~♡
        if (document.readyState === "complete") setTimeout(hideLoader, 150);
        else window.addEventListener("load", function () { setTimeout(hideLoader, 150); });
      })();
    </script>
    <!-- 🌐 「第一次切页地址栏不更新」的旧补丁已移除（实测验证过再删的）：
         Astro 的 ClientRouter 自己就会维护 history。之前手写的那次 pushState
         会在首跳多压一条「同 URL」的历史记录，结果就是：
         按返回键 → 地址栏变了、内容却不切（比它原本要修的问题更严重）。
         去掉后实测：首跳地址正常、连点两页再返回，内容都能正确回来~♡ -->

    <!-- 🔍 站内搜索逻辑（对应优化⑥）：顶栏放大镜打开弹窗，边输入边过滤文章~♡ -->
    <!-- 🔍 搜索数据不再内联：第一次点开搜索时才去 /search.json 取（省掉每页一份全站文章列表）~♡ -->
    <script is:inline>
      (function () {
        // 🔍 搜索逻辑（对应优化⑥）：顶栏放大镜打开横条，边输入边过滤文章~♡
        //  【修复】is:inline 脚本切页【不重跑】，但 View Transitions 会换新 DOM。
        //   所以 input / body 不能在顶层一次性 getElementById（那样会一直指向
        //  「首次加载的旧元素」，切页后就失灵）。改成：把 input/body 存成可变量，
        //   每次 bind() 切页都重新获取「当前最新的元素」，再绑定事件~♡
        var input = null;
        var body = null;

        // 📦 搜索索引（/search.json）：第一次要用时才取，之后放内存复用~♡
        //   · 以前是 define:vars 内联进每页，每页 HTML 都得背一份全站文章列表
        //   · 现在按需拉取：点开搜索 / 鼠标移上去时才请求，切页也不会重复拉
        var postsIndex = null;    // null = 还没取过
        var indexPending = null;  // 正在请求中的 Promise（防连点重复请求）
        function loadIndex() {
          if (postsIndex) return Promise.resolve(postsIndex);
          if (indexPending) return indexPending;
          indexPending = fetch("/search.json")
            .then(function (r) { return r.ok ? r.json() : []; })
            .then(function (data) { postsIndex = Array.isArray(data) ? data : []; return postsIndex; })
            .catch(function () { postsIndex = []; return postsIndex; })
            .then(function (v) { indexPending = null; return v; });
          return indexPending;
        }

        // 🔍 打开搜索：给横条加 .open（配合 CSS 展开动画）+ 聚焦输入框直接搜~♡
        //    【防御】input 可能还没拿到（当前页面没有搜索框），做空值兜底~♡
        function openSearch() {
          var box = document.getElementById("search-box");
          if (box) box.classList.add("open");
          if (input) setTimeout(function () { if (input) input.focus(); }, 50);
          // 索引是懒加载的：取回来后再渲染一次（第一次会有一点点等待）~♡
          loadIndex().then(function () { render(input ? input.value : ""); });
        }
        // 🌙 关闭搜索：收回横条、清空输入和结果~♡
        function closeSearch() {
          var box = document.getElementById("search-box");
          if (box) box.classList.remove("open");
          if (input) { input.blur(); input.value = ""; }
          if (body) body.replaceChildren();   // 直接清空，别让「没搜到」闪一下~♡
        }
        function q(s) { return String(s || "").toLowerCase(); }
        function render(kw) {
          if (!body) return;   // 还没拿到结果容器就跳过~♡
          kw = (kw || "").trim().toLowerCase();
          var list = postsIndex || [];   // 索引还没到就先当空数组，不做任何渲染之外的事~♡
          if (kw) {
            list = list.filter(function (p) {
              return q(p.title).indexOf(kw) >= 0 ||
                     q(p.category).indexOf(kw) >= 0 ||
                     (p.tags || []).some(function (t) { return q(t).indexOf(kw) >= 0; });
            });
          }
          body.replaceChildren();
          if (!list.length) {
            var empty = document.createElement("p");
            empty.className = "search-empty";
            empty.textContent = "（没搜到相关的，换个关键词试试~♡）";
            body.appendChild(empty);
            return;
          }
          list.slice(0, 12).forEach(function (p) {
            var link = document.createElement("a");
            link.className = "search-item";
            link.href = "/posts/" + p.slug + "/";
            var postTitle = document.createElement("span");
            postTitle.className = "si-title";
            postTitle.textContent = p.title;
            var metadata = document.createElement("span");
            metadata.className = "si-tag";
            metadata.textContent = [p.category, (p.tags || []).join(" / "), p.date]
              .filter(Boolean)
              .join(" · ");
            link.append(postTitle, metadata);
            body.appendChild(link);
          });
        }

        // 🔁 绑定（每次切页都重新拿「当前最新的 input/body」再做绑定，修复切页后失灵~♡）
        function bind() {
          // 💡 关键修复：不沿用顶层旧引用，每次重新取最新 DOM 元素~♡
          input = document.getElementById("search-input");
          body = document.getElementById("search-body");
          var b = document.getElementById("btn-search");
          if (b) b.onclick = function (e) {
            e.preventDefault();
            // 🔘 放大镜 = 展开/收起 切换：已在展开态(横条 .open 或输入框聚焦)点它就收回~♡
            var box = document.getElementById("search-box");
            var isOpen = box && box.classList.contains("open");
            var isFocused = input && document.activeElement === input;
            if (isOpen || isFocused) closeSearch();  // 已打开 → 收回（blur 后横条自然缩回~♡）
            else openSearch();                        // 未打开 → 展开~♡
          };
          if (b) b.onmouseenter = loadIndex;   // 手一放到放大镜上就先取索引~♡
          if (input) {
            if (postsIndex) render("");   // 索引已就绪才渲染；没就绪就等点开时再取~♡
            input.oninput = function () { render(input.value); };
            // 📌 聚焦时也刷新一次（保证鼠标离开后仍能看到已搜索的结果~♡）
            input.onfocus = function () { render(input.value); };
            input.onkeydown = function (e) {
              if (e.key === "Enter") render(input.value);
              if (e.key === "Escape") closeSearch();
            };
          }
        }

        // 🔍 点击「搜索区域外」→ 收回横条（修复：输入后点外部空白收不回的 bug~♡）
        //   · 原因：点外部空白只会让输入框 blur（:focus-within 失效），
        //     但 .open 类不会自动移除 → 横条仍靠 .search-box.open 保持展开。
        //   · 这里在顶层注册一次（IIFE 只跑一次），引用的是每次 bind()
        //     更新后的最新 input/body，所以切页后依然准确~♡
        document.addEventListener("click", function (e) {
          var t = e.target;
          // 点到搜索横条/输入框/放大镜内部 → 不算外部，交给各自 toggle 逻辑~♡
          var inside = t && t.closest ? t.closest("#search-box, #btn-search") : null;
          if (!inside) closeSearch();
        });

        bind();
        // 切页后 DOM 会换新，重新绑定一次（is:inline 本身不重跑~♡）
        document.addEventListener("astro:page-load", bind);
      })();
    </script>

        <!-- ⏱️ 跑站时长：从 config.ts 的 siteStart 起算，每秒实时刷新成 天:时:分:秒 -->
    <!-- 【扩展点】想改起算日期 → 改 src/config.ts 的 siteStart 即可，这里不用动~♡ -->
    <!-- 用 Astro 的 define:vars 把 siteStart 传进脚本（不要在脚本里用 ${}，那是无效的~♡） -->
    <!-- 用 window.__upT 做“防重复计时器”标记 + 监听 astro:page-load：
         这样每次切页后（View Transitions 局部刷新）都会重新算一次并继续跳秒，不会停在初始值 0~♡ -->
    <script define:vars={{ siteStart }}>
      (function () {
        // 算出从今天零点起跑了多久，写进 #uptime 元素（找不到就跳过，不影响其它页面）
        // ⚠️ 不能直接 new Date("2026-09-13")：纯日期串会被当成 UTC 零点，非 UTC 地区会算错~♡
        var _p = String(siteStart).split("-");
        var start = new Date(+_p[0], +_p[1] - 1, +_p[2]).getTime(); // 本地时区零点

        function pad(n) { return String(n).padStart(2, "0"); }
        function setUptime() {
          var el = document.getElementById("uptime");
          if (!el) return;
          var diff = Date.now() - start;
          if (isNaN(diff)) diff = 0;
          if (diff < 0) diff = 0;                       // 日期还没到就算 0
          var d  = Math.floor(diff / 86400000);
          var h  = Math.floor(diff % 86400000 / 3600000);
          var m  = Math.floor(diff % 3600000 / 60000);
          var s  = Math.floor(diff % 60000 / 1000);
          el.textContent = d + "天 " + pad(h) + ":" + pad(m) + ":" + pad(s);
        }

        // 启动秒定时器（用全局标记避免跨页面切来切去时重复开很多个定时器）
        if (!window.__upT) window.__upT = setInterval(setUptime, 1000);

        // 首次加载 + 每次切页（astro:page-load）都重新算一次，覆盖新页面里的服务端初始值
        setUptime();
        document.addEventListener("astro:page-load", setUptime);
      })();
    </script>

    <!-- 📋 代码块「复制」按钮（全局委托，只绑定一次；对应优化：代码一键复制~♡） -->
    <script is:inline>
      (function () {
        if (window.__codeCopyBound) return;   // 切页时 window 是持久的，防重复绑定~♡
        window.__codeCopyBound = true;
        function fallbackCopy(text) {
          var ta = document.createElement("textarea");
          ta.value = text; ta.setAttribute("readonly", "");
          ta.style.position = "fixed"; ta.style.opacity = "0";
          document.body.appendChild(ta); ta.select();
          try { document.execCommand("copy"); } catch (e) {}
          document.body.removeChild(ta);
        }
        document.addEventListener("click", function (e) {
          var btn = e.target && e.target.closest ? e.target.closest(".code-copy") : null;
          if (!btn) return;
          var block = btn.closest(".code-block");
          var pre = block && block.querySelector(".code-block pre");
          if (!pre) return;
          var text = pre.textContent || "";
          var done = function () {
            var old = btn.textContent;
            btn.textContent = "已复制";
            setTimeout(function () { btn.textContent = old; }, 1600);
          };
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
          } else { fallbackCopy(text); done(); }
        });
      })();
    </script>

</body>
</html>
