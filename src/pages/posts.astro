---
// ============================================================
//  📝 日志列表 — 中间内容区
//  文章来自 src/content/posts/。点标题进 /posts/<slug>/。
// ============================================================
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---
<Layout active="posts">
  <section class="card" style="padding:20px; margin-bottom:24px;">
    <h1 style="font-size:24px; letter-spacing:2px; color:var(--accent);"><Icon name="book" size={20} />&nbsp;日记 / 文章</h1>
    <p style="margin-top:10px; line-height:1.8; color:var(--text);">
      这里是我的日志小本本~ 想写一篇，就在
      <code style="color:var(--accent);">src/content/posts/</code> 新增 Markdown 文件，填写文章信息并写正文，列表和详情页会自动生成。
    </p>
  </section>

  <section>
    {posts.length > 0 ? (
      <ul class="posts">
        {posts.map((p) => (
          <PostCard post={p} />
        ))}
      </ul>
    ) : (
      <div class="card" style="padding:34px; text-align:center;">
        <div style="color:var(--accent);"><Icon name="book" size={48} /></div>
        <p class="empty" style="margin-top:12px;">还没有文章~ 去 src/content/posts/ 添加第一篇吧！</p>
      </div>
    )}
  </section>
</Layout>
