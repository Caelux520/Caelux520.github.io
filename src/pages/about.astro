---
// ============================================================
//  👤 关于我 / 档案 (About) — 中间内容区
// ============================================================
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { site } from "../config";

// 个人资料小卡片（想改/加在这里改即可）
// 别名留空就不显示这一栏~♡
const facts: { k: string; v: string }[] = [
  { k: "名字",   v: site.name },
  ...(site.alias ? [{ k: "别名", v: site.alias }] : []),
  { k: "坐标",   v: "二次元与三次元之间" },
  { k: "属性",   v: "猫娘 / 声控 / 收藏癖" },
  { k: "技能",   v: "前端 · 二次元站点 · 脑洞项目" },
];
---
<Layout active="about">
  <section class="card">
    <h1 style="font-size:24px; letter-spacing:2px; color:var(--accent);"><Icon name="user" size={20} />&nbsp;关于我</h1>
    <p style="margin-top:12px; line-height:1.9; color:var(--text);">
      你好呀~这里是 <b>{site.name}</b>。一个喜欢二次元、会写点代码、爱收藏可爱东西的阿宅。
      这个房间（部屋）就是我的互联网小据点，欢迎来坐坐~♡
    </p>
  </section>

  <section class="sec" style="margin-top:22px;">
    <h2 class="sec-title">个人资料</h2>
    <div class="card fact-shell">
      {facts.map((f) => (
        <div class="fact"><span class="k">{f.k}</span><span class="v">{f.v}</span></div>
      ))}
    </div>
  </section>
</Layout>

<style>
  .fact-shell { padding: 8px 22px; }
  .fact { display: flex; padding: 13px 0; border-bottom: 1px dashed var(--border); }
  .fact:last-child { border-bottom: none; }
  .fact .k { width: 96px; color: var(--accent); font-weight: 600; letter-spacing: 1px; }
  .fact .v { color: var(--text); }
  @media (max-width: 600px) { .fact .k { width: 74px; } }
</style>
