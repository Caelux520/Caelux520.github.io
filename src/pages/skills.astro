---
// ============================================================
//  🛠️ 技能 (Skills) — 对应升级 #5
//  数据在 src/config.ts 的 skills；level 1~10 决定进度条~♡
//  「扩展点」：copy 一行 { name, level, icon } 加技能~♡
// ============================================================
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { skills } from "../config";
---
<Layout active="skills">
  <section class="card" style="padding:20px; margin-bottom:24px;">
    <h1 style="font-size:24px; letter-spacing:2px; color:var(--accent);"><Icon name="heart" size={20}/>&nbsp;技能</h1>
    <p style="margin-top:10px; line-height:1.8; color:var(--text);">
      目前点亮的技能树~♡
    </p>
  </section>

  <section>
    {skills.length > 0 ? (
      <div class="skill-grid">
        {skills.map((s) => (
          <div class="skill card">
            <div class="skill-row">
              <span class="skill-icon">{s.icon}</span>
              <span class="skill-name">{s.name}</span>
              <span class="skill-lv">{s.level}/10</span>
            </div>
            <div class="skill-bar"><i style={`width:${s.level * 10}%`}></i></div>
          </div>
        ))}
      </div>
    ) : (
      <div class="card" style="padding:34px; text-align:center;">
        <div style="color:var(--accent);"><Icon name="heart" size={48} /></div>
        <p class="empty" style="margin-top:12px;">技能树还没点亮~ 去 config 的 <b>skills</b> 加一条吧~♡</p>
      </div>
    )}
  </section>
</Layout>

<style>
  .skill-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap:14px; }
  .skill { padding: 18px; }
  .skill-row { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
  .skill-icon { font-size:22px; }
  .skill-name { flex:1; font-weight:600; font-size:15px; color:var(--text-bright); }
  .skill-lv { font-size:12px; color:var(--text-dim); }
  .skill-bar { height:8px; border-radius:5px; overflow:hidden;
    background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .skill-bar i { display:block; height:100%; border-radius:5px;
    background: linear-gradient(90deg, var(--accent), var(--accent2)); }
</style>
