---
// ============================================================
//  🖼️ 壁纸收藏 (Walls) — 参考站「专辑」那种版式
// ------------------------------------------------------------
//  结构：标题卡（图标 + 标题 + 说明）→ 搜索框 → 标签胶囊 → 张数 → 卡片网格
//  每张卡片：封面（左上角分区角标 / 右下角放大按钮）+ 标题箭头 + 简介 + 元信息 + 标签
//  点卡片进详情页，点放大按钮直接开灯箱（← → 可以连着看~♡）
// ============================================================
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import WallLightbox from "../components/WallLightbox.astro";
import { walls } from "../config";

const totalBytes = walls.reduce((sum, w) => sum + (w.bytes || 0), 0);
const sizeText = totalBytes ? (totalBytes / 1024 / 1024).toFixed(1) + " MB" : null;

// 分区（分类）数量
const categories = [...new Set(walls.map((w) => w.category))];

// 标签 → 张数（胶囊用标签筛，和参考站一样~♡）
const tagCounts = new Map<string, number>();
for (const w of walls) {
  for (const t of w.tags || []) tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
}
const tagList = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

// 卡片上的小字：尺寸 · 分区 · 体积
function metaLine(w: (typeof walls)[number]) {
  const parts: string[] = [];
  if (w.width && w.height) parts.push(w.width + " × " + w.height);
  parts.push(w.category);
  if (w.bytes) parts.push((w.bytes / 1024 / 1024).toFixed(2) + " MB");
  return parts.join(" · ");
}
---
<Layout active="walls" title="壁纸收藏 · いんしゅん の部屋" desc="收集到的壁纸都在这里，点开可以看原图~">
  <!-- ---------- 标题卡 ---------- -->
  <section class="card wl-head">
    <span class="wl-kicker"><Icon name="image" size={14} /> WALLPAPER ARCHIVE</span>
    <h1>壁纸收藏</h1>
    <p>一个关于人物、风景和喜欢过的瞬间的视觉档案。</p>
  </section>

  <!-- ---------- 搜索 / 标签 / 张数 ---------- -->
  <section class="card wl-tools">
    <label class="wl-search">
      <Icon name="search" size={15} />
      <input id="wl-q" type="search" placeholder="搜索壁纸名字 / 标签…" autocomplete="off" />
    </label>

    <div class="wl-chips" id="wl-cats">
      <button type="button" class="wl-chip on" data-tag="" aria-pressed="true">全部 <b>{walls.length}</b></button>
      {tagList.map(([tag, count]) => (
        <button type="button" class="wl-chip" data-tag={tag} aria-pressed="false">#{tag} <b>{count}</b></button>
      ))}
    </div>

    <p class="wl-count-line"><b id="wl-count">{walls.length}</b> 张壁纸 · {categories.length} 个分区{sizeText ? " · " + sizeText : ""}</p>
  </section>

  <!-- ---------- 网格 ---------- -->
  {walls.length > 0 ? (
    <div class="wl-grid" id="wl-grid">
      {walls.map((w) => (
        <article class="wl-card" data-tags={(w.tags || []).join(",")} data-cat={w.category} data-text={(w.title + " " + (w.desc || "") + " " + (w.tags || []).join(" ") + " " + w.category).toLowerCase()}>
          <div class="wl-cover">
            <a class="wl-cover-link" href={"/walls/" + w.slug + "/"} aria-label={"打开 " + w.title + " 的详情"}>
              <img src={w.thumb ?? w.preview ?? w.src} alt={w.title} loading="lazy" decoding="async" />
            </a>
            <span class="wl-cat">{w.category}</span>
            <button
              type="button"
              class="wl-zoom"
              data-wall-open
              data-wall-full={w.large ?? w.src}
              data-wall-title={w.title}
              aria-label={"放大查看 " + w.title}
            ><Icon name="expand" size={14} /></button>
          </div>

          <div class="wl-body">
            <a class="wl-title" href={"/walls/" + w.slug + "/"}>
              <span>{w.title}</span>
              <span class="wl-arrow"><Icon name="arrow-right" size={14} /></span>
            </a>
            {w.desc ? <p class="wl-desc">{w.desc}</p> : null}
            <p class="wl-meta">{metaLine(w)}</p>
            {(w.tags || []).length > 0 ? (
              <div class="wl-tags">{(w.tags || []).map((t) => <span>#{t}</span>)}</div>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="card" style="padding:34px; text-align:center;">
      <div style="color:var(--accent);"><Icon name="image" size={44} /></div>
      <p class="empty" style="margin-top:12px;">
        还没有壁纸~ 把图片放进 <code style="color:var(--accent);">public/walls/</code>，
        再到 <code style="color:var(--accent);">src/config/lists.ts</code> 的 <code style="color:var(--accent);">walls</code> 里加一行就出现了~♡
      </p>
    </div>
  )}

  <p class="wl-empty" id="wl-empty" hidden>没有找到符合的壁纸，换个关键词试试？~♡</p>

  <WallLightbox />
</Layout>

<style>
  /* ---------- 标题卡 ---------- */
  .wl-head {
    position: relative;
    padding: 24px;
    margin-bottom: 12px;
    overflow: hidden;
  }
  .wl-head::before {
    content: "";
    position: absolute;
    width: 220px;
    height: 220px;
    right: -80px;
    top: -110px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 20%, transparent), transparent 68%);
    pointer-events: none;
  }
  .wl-kicker {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2.2px;
    color: var(--accent);
  }
  .wl-head h1 {
    position: relative;
    margin: 9px 0 0;
    font-size: 26px;
    letter-spacing: 2px;
    color: var(--accent);
  }
  .wl-head p {
    position: relative;
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.8;
    color: var(--text-dim);
  }

  /* ---------- 工具条 ---------- */
  .wl-tools {
    padding: 14px 16px 12px;
    margin-bottom: 14px;
  }
  .wl-search {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0 14px;
    height: 42px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card-bg) 70%, transparent);
    color: var(--text-dim);
    transition: border-color .2s ease, box-shadow .2s ease;
  }
  .wl-search:focus-within {
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .wl-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font-family: inherit;
    font-size: 13px;
  }
  .wl-search input::placeholder { color: var(--text-dim); }
  .wl-search input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .wl-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 12px;
  }
  .wl-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    font-family: inherit;
    font-size: 11.5px;
    line-height: 1;
    cursor: pointer;
    transition: color .18s ease, border-color .18s ease, background .18s ease;
  }
  .wl-chip:hover { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 45%, var(--border)); }
  .wl-chip b {
    font-size: 10px;
    font-weight: 600;
    color: var(--text-dim);
  }
  .wl-chip.on {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    box-shadow: 0 4px 12px color-mix(in srgb, var(--accent) 28%, transparent);
  }
  .wl-chip.on b { color: rgba(255, 255, 255, .85); }

  .wl-count-line {
    margin: 12px 2px 0;
    font-size: 11.5px;
    color: var(--text-dim);
  }
  .wl-count-line b { color: var(--accent); font-size: 12.5px; }

  /* ---------- 网格 ---------- */
  .wl-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .wl-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card-bg);
    backdrop-filter: blur(10px);
    transition: transform .22s ease, border-color .22s ease, box-shadow .22s ease;
  }
  .wl-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    box-shadow: 0 14px 30px rgba(0, 0, 0, .09);
  }
  .wl-card[hidden] { display: none; }

  .wl-cover {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--accent) 6%, var(--card-bg));
  }
  .wl-cover-link { display: block; height: 100%; }
  .wl-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }
  .wl-card:hover .wl-cover img { transform: scale(1.045); }

  .wl-cat {
    position: absolute;
    left: 9px;
    top: 9px;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(15, 12, 30, .55);
    color: #fff;
    font-size: 10px;
    letter-spacing: .5px;
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
  .wl-zoom {
    position: absolute;
    right: 9px;
    bottom: 9px;
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, .28);
    border-radius: 9px;
    background: rgba(15, 12, 30, .5);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity .2s ease, transform .2s ease, background .2s ease;
    backdrop-filter: blur(8px);
  }
  .wl-card:hover .wl-zoom,
  .wl-zoom:focus-visible { opacity: 1; transform: translateY(0); }
  .wl-zoom:hover { background: color-mix(in srgb, var(--accent) 70%, rgba(15, 12, 30, .5)); }

  .wl-body { padding: 12px 14px 14px; }
  .wl-title {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-bright);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    line-height: 1.5;
  }
  .wl-title > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .wl-arrow {
    margin-left: auto;
    display: inline-flex;
    color: var(--text-dim);
    transition: transform .2s ease, color .2s ease;
  }
  .wl-title:hover { color: var(--accent); text-decoration: none; }
  .wl-title:hover .wl-arrow { transform: translateX(3px); color: var(--accent); }

  .wl-desc {
    margin-top: 6px;
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--text-dim);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .wl-meta {
    margin-top: 9px;
    font-size: 10.5px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .wl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 8px;
  }
  .wl-tags span {
    font-size: 10px;
    color: color-mix(in srgb, var(--accent) 80%, var(--text-dim));
  }

  .wl-empty {
    margin: 22px 0 6px;
    text-align: center;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  @media (max-width: 640px) {
    .wl-head { padding: 20px; }
    .wl-head h1 { font-size: 22px; }
    .wl-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .wl-title { font-size: 13px; }
    .wl-body { padding: 10px 11px 12px; }
    .wl-desc { display: none; }
    .wl-zoom { opacity: 1; transform: none; width: 26px; height: 26px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wl-card, .wl-cover img, .wl-zoom, .wl-arrow { transition: none; }
  }
</style>

<script>
  // 🖼️ 壁纸筛选：搜索词 + 标签胶囊（纯前端，不发请求~♡）
  function setupWallFilters() {
    const grid = document.getElementById("wl-grid");
    if (!grid || grid.dataset.ready === "1") return;
    grid.dataset.ready = "1";

    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".wl-card"));
    const input = document.querySelector<HTMLInputElement>("input#wl-q");
    const chipBox = document.getElementById("wl-cats");
    const countEl = document.getElementById("wl-count");
    const empty = document.getElementById("wl-empty");
    if (!chipBox) return;

    const chips = Array.from(chipBox.querySelectorAll<HTMLButtonElement>(".wl-chip"));
    let currentTag = "";

    function apply() {
      const term = (input && input.value ? input.value : "").trim().toLowerCase();
      let shown = 0;

      cards.forEach(function (card) {
        const tags = (card.getAttribute("data-tags") || "").split(",");
        const okTag = !currentTag || tags.indexOf(currentTag) !== -1;
        const okTerm = !term || (card.getAttribute("data-text") || "").indexOf(term) !== -1;
        const show = okTag && okTerm;
        card.hidden = !show;
        if (show) shown++;
      });

      if (countEl) countEl.textContent = String(shown);
      if (empty) empty.hidden = shown !== 0;
    }

    chips.forEach(function (chip) {
      chip.addEventListener("click", function () {
        currentTag = chip.getAttribute("data-tag") || "";
        chips.forEach(function (item) {
          const on = item === chip;
          item.classList.toggle("on", on);
          item.setAttribute("aria-pressed", on ? "true" : "false");
        });
        apply();
      });
    });

    if (input) {
      input.addEventListener("input", apply);
      // / 键快速聚焦搜索框
      document.addEventListener("keydown", function (event) {
        if (event.key !== "/" || event.metaKey || event.ctrlKey) return;
        const el = document.activeElement;
        const typing = el instanceof HTMLElement && (el.tagName === "INPUT" || el.tagName === "TEXTAREA" || el.isContentEditable);
        if (typing || !grid.isConnected) return;
        event.preventDefault();
        input.focus();
      });
    }
  }

  setupWallFilters();
  document.addEventListener("astro:page-load", setupWallFilters);
</script>
