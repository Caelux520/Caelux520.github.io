---
// ============================================================
//  🖼️ 壁纸收藏 / 链接 — 中间内容区
//  想加壁纸：图片放 public/walls/，再到 src/config.ts 的 walls 加一行。
// ============================================================
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { walls } from "../config";
---
<Layout active="walls">
  <section class="card" style="padding:20px; margin-bottom:24px;">
    <h1 style="font-size:24px; letter-spacing:2px; color:var(--accent);"><Icon name="image" size={20} />&nbsp;壁纸收藏</h1>
    <p style="margin-top:10px; line-height:1.8; color:var(--text);">
      收藏的可爱壁纸都放这啦~ 想加新的，把图片放进
      <code style="color:var(--accent);">public/walls/</code>，再到
      <code style="color:var(--accent);">src/config.ts</code> 的 <b>walls</b> 加一行即可。
    </p>
  </section>

  <section>
    {walls.length > 0 ? (
      <div class="wall-grid">
        {walls.map((w) => (
          <div class="wall">
            <img src={w.src} alt={w.title} loading="lazy" />
            <span class="t">{w.title}</span>
          </div>
        ))}
      </div>
    ) : (
      <div class="card" style="padding:34px; text-align:center;">
        <div style="color:var(--accent);"><Icon name="image" size={48} /></div>
        <p class="empty" style="margin-top:12px;">这里还没放壁纸~ 去 <code style="color:var(--accent);">public/walls/</code> 放图，再在 config 的 walls 填一行就会显示啦！</p>
      </div>
    )}
  </section>
</Layout>
