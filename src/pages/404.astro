---
// ============================================================
//  🌫️ 404 页面 — 找不到啦~
//  访问不存在地址时会显示这个可爱的小页面。
// ============================================================
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---
<Layout active="">
  <section class="card" style="padding:56px 26px; text-align:center;">
    <div class="big404"><Icon name="ghost" size={80} /></div>
    <h1 style="font-size:30px; letter-spacing:2px; color:var(--accent); margin-top:14px;">404</h1>
    <p style="margin-top:12px; line-height:1.8; color:var(--text);">
      哎呀…这个房间好像不存在呢~♡<br />
      大概是走错部屋啦，快回首页吧~
    </p>
    <a class="btn404" href="/"><Icon name="home" size={16} />&nbsp;回到首页</a>
  </section>
</Layout>

<style>
  .btn404 {
    display: inline-block; margin-top: 22px; padding: 11px 26px; border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    color: #fff; font-weight: 600; letter-spacing: 1px; text-decoration: none;
    box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 40%, transparent);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  .btn404:hover { transform: translateY(-2px); box-shadow: 0 10px 24px color-mix(in srgb, var(--accent) 55%, transparent); text-decoration: none; }
</style>
