<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>我的个人主页</title>
    <style>
      body {
        margin: 0;
        height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        /* 二次元粉蓝渐变背景 */
        background: linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%);
        font-family: "Microsoft YaHei", sans-serif;
      }

      .awa {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        border: 4px solid #ffffff;
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.8);
        margin-bottom: 20px;
        /* 关键：确保图片填充圆形区域，且不变形 */
        object-fit: cover;
        display: block;
      }

      h1 {
        color: #ffffff;
        text-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        letter-spacing: 2px;
        margin-bottom: 10px;
      }

      p {
        color: #ffffff;
        opacity: 0.8;
        font-size: 16px;
      }
    </style>
  </head>
  <body>
    <!-- 使用 img 标签直接引入图片 -->
    <img class="awa" src="/awa.jpg" alt="我的头像" />
    
    <h1>Welcome to my world</h1>
    <p>个人主页搭建中...</p>
  </body>
</html>