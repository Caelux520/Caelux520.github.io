---
// ============================================================
//  🔔 全局小提示窗 (Toast)
// ------------------------------------------------------------
//  站内任何地方想让页面「轻轻弹一句话」，都能用它~♡
//  · 在 Layout 里引入一次 → 全站可用（目前就挂在 Layout.astro 里）
//  · 逻辑 + 完整用法说明 → src/lib/toast.ts
//  · 外观 + 动画 → 本文件底部的 <style is:global>
//
//  【怎么用】
//   ① 声明式（最省事）：给任意元素加 data-toast="文案"
//        <button data-toast="还没弄好哦~♡">点我</button>
//        <a data-toast="…" data-toast-type="warn" data-toast-duration="4000">…</a>
//   ② 脚本式（想自己控制时机）
//        import { toast } from "../lib/toast";
//        toast("保存成功啦~♡", { type: "success" });
//        window.toast("…")   // is:inline 老脚本里也能直接调~♡
//
//  【想加新配色】在这里补一段 .toast--error { ... } 就行，
//   然后 toast("…", { type: "error" })，JS 完全不用动~♡
// ============================================================
---

<script>
  // 只把这套逻辑装进浏览器 bundle（Astro 会自动打包 + 跨页缓存），
  // 里面会做：① 全局点击委托  ② 挂 window.toast~♡
  import "../lib/toast";
</script>

<style is:global>
  /* ============================================================
     🔔 提示窗样式
     · 位置：贴在顶部导航栏下方、水平居中，不挡导航也不挡右下角播放器~♡
     · 层级：960 —— 高于顶栏(900)、低于加载动画(9999)~♡
     · 想挪位置：改下面的 top 即可（手机端在 @media 里单独调）
     ============================================================ */
  .toast-stack {
    position: fixed; top: 78px; left: 50%; transform: translateX(-50%);
    z-index: 960;
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    width: max-content; max-width: min(92vw, 420px);
    pointer-events: none;            /* 空白处不挡页面点击，只有提示本身可点~♡ */
  }

  .toast {
    pointer-events: auto;
    display: flex; align-items: center; gap: 8px;
    max-width: 100%;
    padding: 10px 16px; border-radius: 999px;
    font-size: 13px; line-height: 1.5;
    color: var(--text-bright);
    background: rgba(255, 255, 255, .95);
    border: 1px solid var(--border);
    box-shadow: 0 10px 26px rgba(0, 0, 0, .16);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    cursor: pointer;                 /* 点一下可以提前收掉~♡ */
    user-select: none;
    /* 入场/退场：位移 + 淡入，用 spring 感的缓动，软软的~♡ */
    opacity: 0; transform: translateY(-10px) scale(.96);
    transition: opacity .22s ease, transform .22s cubic-bezier(.22, 1, .36, 1);
    will-change: opacity, transform;
  }
  /* 暗色：换成深底，不然白底 + 白字看不清~♡ */
  html.dark .toast {
    background: rgba(26, 19, 48, .95);
  }

  .toast.is-in  { opacity: 1; transform: none; }
  .toast.is-out { opacity: 0; transform: translateY(-6px) scale(.98); }

  .toast__icon { font-size: 15px; line-height: 1; flex: none; }
  .toast__msg  { word-break: break-word; }

  /* ---------- 三种基础配色（边框微染色，不抢眼~♡） ---------- */
  .toast--info    { border-color: color-mix(in srgb, var(--accent) 32%, var(--border)); }
  .toast--success { border-color: color-mix(in srgb, #26c281 55%, var(--border)); }
  .toast--warn    { border-color: color-mix(in srgb, #ffab2e 60%, var(--border)); }

  /* ---------- 手机端：顶栏更矮，往上收一点；两边留白别贴边~♡ ---------- */
  @media (max-width: 860px) {
    .toast-stack { top: 70px; max-width: 94vw; }
    .toast { font-size: 12.5px; padding: 9px 14px; }
  }

  /* ---------- 系统开了「减少动效」：不做位移，只淡淡显隐~♡ ---------- */
  @media (prefers-reduced-motion: reduce) {
    .toast { transition: opacity .15s linear; transform: none; }
    .toast.is-in, .toast.is-out { transform: none; }
  }
</style>
