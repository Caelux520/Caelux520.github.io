---
// ============================================================
//  🎵 音乐播放器（独立区块 · 可自包含复用 · 参考 Mizuki 风格）
// ------------------------------------------------------------
//  ✅ 这是「一块独立的功能模块」：只有本文件 + config.ts 的 music，
//     全部逻辑/样式都在这一处，想整体增删都很干净，不影响其它页面~
//
//  🎧 现有功能：
//  ✔ 迷你播放条：小封面 + ♪歌名 + 播放/暂停 + 展开 —— 常驻底部
//  ✔ 展开大卡：左封面(旋转唱片) + 歌名 + 歌手 + 进度 + 内联音量条 + 歌单
//  ✔ FAB 小球：点「隐藏」缩成右下角旋转小唱片，Click 回来
//  ✔ 播放模式：列表循环 / 单曲循环 / 随机播放
//  ✔ 跨页不断歌：View Transitions 保留 <audio>，localStorage 记住
//     当前歌/模式/音量/进度，切页后自动同步（详见脚本内「跨页延续」区）
//  ✔ 音量条内联：拖动手感（指针捕获），空格/M/方向键快捷键
//
//  🧩 后期扩展预留（想加新功能就在对应位置加，别乱动逻辑区）：
//  · 想加歌：只改 src/config.ts 的 music 数组即可（title/artist/url/cover）
//  · 想加「歌词 / 播放列表进度 / 收藏喜欢 / 单曲下载」等：
//    → 在下方模板合适位置加标签，并把对应 CSS 加在 <style> 里~♡
//  · 想改跨页记忆的字段：在脚本的「跨页延续」区 getSt/setSt 里增删即可
// ============================================================
import Icon from "./Icon.astro";
import { music } from "../config";
const hasTrack = music && music.length > 0;
const firstCover = hasTrack && music[0].cover ? music[0].cover : "";
---

<div class="mp-root" id="mp-root" transition:persist>
  <!-- 🎈 FAB 小球（隐藏态：右下角旋转小唱片，点击展开） -->
  <button class="mp-orb" id="mp-orb" title="展开播放器" aria-label="展开播放器">
    <span class="mp-orb-halo"></span>
    <span class="mp-orb-cover">
      {hasTrack && music[0].cover ? (
        <img id="mp-orb-img" src={firstCover} alt="" loading="lazy" />
      ) : (
        <Icon name="music" size={22} />
      )}
    </span>
    <span class="mp-orb-pin"></span>
  </button>

  <!-- 🎈 迷你播放条（常驻底部） -->
  <button class="mp-mini" id="mp-mini" aria-label="展开播放器">
    <span class="mp-mini-cover" id="mp-mini-cover">
      {hasTrack && music[0].cover ? (
        <img id="mp-mini-img" src={firstCover} alt="" loading="lazy" />
      ) : (
        <Icon name="music" size={16} />
      )}
    </span>
    <span class="mp-mini-title" id="mp-mini-title">
      {hasTrack ? music[0].title : "播放列表"}
    </span>
    <span class="mp-mini-play" id="mp-mini-play" title="播放/暂停" aria-label="播放/暂停">
      <Icon name="play" size={18} />
    </span>
    <span class="mp-mini-expand" id="mp-mini-expand" title="展开/收起" aria-label="展开/收起">
      <Icon name="up" size={16} />
    </span>
  </button>

  <!-- 🎴 展开大卡 -->
  <div class="mp-card" id="mp-card">
    <!-- 头部：标题 + 歌单 / 隐藏 / 收起 -->
    <div class="mp-head">
      <div class="sec-title" style="margin:0;"><Icon name="music" size={14} />&nbsp;播放器</div>
      <div class="mp-head-btns">
        <button class="mp-collapse" id="mp-hide" title="隐藏成小球" aria-label="隐藏成小球">
          <Icon name="fold" size={16} />
        </button>
        <button class="mp-collapse" id="mp-collapse" title="收起" aria-label="收起">
          <Icon name="down" size={16} />
        </button>
      </div>
    </div>

    <!-- 横向主体：左封面 + 右信息/进度/控制（Mizuki 扁平卡） -->
    <div class="mp-row">
      <div class="mp-cover" id="mp-disc">
        {hasTrack ? (
          <img id="mp-cover" src={firstCover} alt="封面" loading="lazy" />
        ) : (
          <span class="mp-disc-ic"><Icon name="music" size={28} /></span>
        )}
      </div>
      <div class="mp-body">
        <div class="mp-meta">
          <div class="mp-title" id="mp-title">{hasTrack ? music[0].title : "还没有播放"}</div>
          <div class="mp-art-row">
            <div class="mp-art" id="mp-art">{hasTrack ? (music[0].artist || "待播放~♡") : "点下方曲目开始~♡"}</div>
            <!-- 音量图标 + 内联条（歌手旁，可拖动~♡） -->
            <span class="mp-vol-ic"><Icon name="volume" size={13} /></span>
            <span class="mp-vol-bar" id="mp-vol-bar" title="音量 (M 静音)" aria-label="音量">
              <span class="mp-vol-fill" id="mp-vol-fill"></span>
            </span>
          </div>
        </div>
        <div class="mp-time">
          <span id="mp-cur">0:00</span>
          <span id="mp-dur">0:00</span>
        </div>
        <div class="mp-prog" id="mp-prog"><div class="mp-prog-fill" id="mp-fill"></div></div>
        <div class="mp-btns">
          <button class="mp-mode" id="mp-mode" title="播放模式" aria-label="播放模式"><Icon name="list" size={15} /></button>
          <button class="mp-navbtn" id="mp-prev" title="上一首" aria-label="上一首"><Icon name="prev" size={17} /></button>
          <button class="mp-play" id="mp-play" title="播放/暂停" aria-label="播放/暂停"><Icon name="play" size={22} /></button>
          <button class="mp-navbtn" id="mp-next" title="下一首" aria-label="下一首"><Icon name="next" size={17} /></button>
          <!-- 歌单键（取代原音量键的位置~♡） -->
          <button class="mp-mode" id="mp-pl-toggle" title="歌单" aria-label="歌单"><Icon name="list" size={15} /></button>
        </div>
      </div>
    </div>

    <!-- 歌单 -->
    <ul class="mp-list" id="mp-list">
      {hasTrack ? (
        music.map((m, i) => (
          <li>
            <button class="mp-item" data-i={i} data-url={m.url || ""} data-cover={m.cover || ""}>
              <span class="mp-itm-ic"><Icon name="music" size={12} /></span>
              <span class="mp-tx">{m.title}</span>
              <span class="mp-art2">{m.artist}</span>
            </button>
          </li>
        ))
      ) : (
        <li><span class="empty">还没有歌，去 config 的 music 加几首~♡</span></li>
      )}
    </ul>
  </div>

  <!-- 隐藏音频 -->
  <!-- ⚠️ 这里【不要】再写 transition:persist：
       它已经在 #mp-root 这个 persist 子树里了。Astro 切页时会把每个 persist 元素
       单独挪到 <html> 下再放回来，嵌套 persist 会导致内层（audio）被拎出来、
       外层整体替换后内层的目标变成「孤儿」，moveBefore 抛 HierarchyRequestError
       → 整页交换中断，表现就是「点链接没反应 / 一直卡在加载层」。
       只保留外层 #mp-root 即可：整棵子树（含 audio）会一起搬过去，歌照样不断~♡ -->
  <audio id="mp-audio" preload="none"></audio>
</div>

<script is:inline>
  (function () {
    var audio = document.getElementById("mp-audio");
    var root = document.getElementById("mp-root");
    var playBtn = document.getElementById("mp-play");
    var miniPlay = document.getElementById("mp-mini-play");
    var prevBtn = document.getElementById("mp-prev");
    var nextBtn = document.getElementById("mp-next");
    var modeBtn = document.getElementById("mp-mode");
    var volBar = document.getElementById("mp-vol-bar");
    var volFill = document.getElementById("mp-vol-fill");
    var list = document.getElementById("mp-list");
    var title = document.getElementById("mp-title");
    var artist = document.getElementById("mp-art");
    var disc = document.getElementById("mp-disc");
    var coverImg = document.getElementById("mp-cover");
    var miniImg = document.getElementById("mp-mini-img");
    var miniCover = document.getElementById("mp-mini-cover");
    var orb = document.getElementById("mp-orb");
    var orbImg = document.getElementById("mp-orb-img");
    var miniTitle = document.getElementById("mp-mini-title");
    var cur = document.getElementById("mp-cur");
    var dur = document.getElementById("mp-dur");
    var prog = document.getElementById("mp-prog");
    var fill = document.getElementById("mp-fill");
    var items = document.querySelectorAll(".mp-item");
    var count = items.length;

    // ---- 跨页延续：状态存取（localStorage）+ 首次挂载标记 ----
    // 页面用 View Transitions 切换时，<audio> 和 #mp-root 会被 persist 保留，
    // 音频会一直继续放。这里用 localStorage 记住 歌/模式/音量/进度，
    // 并靠 audio.__mpBound 标记避免重复绑定事件。这是「跨页不断歌」的核心~♡
    var bound = !!(audio && audio.__mpBound);
    var MPS = "mp-state";
    function getSt() {
      try { return JSON.parse(localStorage.getItem(MPS) || "null") || {}; } catch (e) { return {}; }
    }
    function setSt() {
      try {
        localStorage.setItem(MPS, JSON.stringify({
          i: currentIndex(), mode: mode, vol: volume, muted: muted, t: audio.currentTime || 0,
        }));
      } catch (e) {}
    }

    // ---- 迷你条 / 展开卡 / 小球 三态切换 ----
    var miniBar = document.getElementById("mp-mini");
    var card = document.getElementById("mp-card");
    var miniExpand = document.getElementById("mp-mini-expand");
    var collapseBtn = document.getElementById("mp-collapse");
    var hideBtn = document.getElementById("mp-hide");
    var isCardOpen = false;
    var isHidden = false;

    function setCardOpen(open, instant) {
      isCardOpen = open;
      if (isHidden) return; // 小球态不处理卡片
      if (open) {
        card.classList.remove("leave");
        card.classList.add("show");
        root.classList.add("open");
        if (!instant) {
          card.classList.remove("enter");
          void card.offsetWidth; // ⬅ 强制回流，确保 enter 展开动画每次都能触发~♡
          card.classList.add("enter");
        }
      } else {
        // 🗜 收起动画：先缩小(leave) → 动画结束再真正隐藏~♡
        if (card.classList.contains("show")) {
          card.classList.remove("enter");
          card.classList.add("leave");
          void card.offsetWidth; // ⬅ 强制回流，修复「首次进入收起不播动画」bug~
          //  └ 首次整页加载时若不加回流，@keyframes mp-shrink 偶尔不重新触发；
          //    切页后时序不同才会正常。加这一行后首次/切页都稳定重播~♡
          setTimeout(function () {
            card.classList.remove("show", "enter", "leave");
            root.classList.remove("open");
          }, 280); // 💡 可调：应与 mp-shrink 时长(260ms)+留白匹配~♡
        } else {
          root.classList.remove("open");
        }
      }
    }
    function setHidden(hidden) {
      isHidden = hidden;
      root.classList.toggle("hidden", hidden);
      if (hidden) {
        card.classList.remove("show", "enter");
        root.classList.remove("open");
        isCardOpen = false;
      }
    }

    if (!bound) {   // 只有首次挂载才绑定事件（跨页时音频已 persist，避免重复绑定~♡）
    if (miniExpand) miniExpand.addEventListener("click", function (e) {
      e.stopPropagation();
      setCardOpen(!isCardOpen);
    });
    if (collapseBtn) collapseBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      setCardOpen(false);
    });
    if (hideBtn) hideBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      setHidden(true);
    });
    if (orb) orb.addEventListener("click", function () {
      setHidden(false);
      setCardOpen(true);
    });
    // 歌单按钮（在控制区，原音量键位置）：展开/收起歌单
    var playlistBtn = document.getElementById("mp-pl-toggle");
    if (playlistBtn && list) playlistBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      list.classList.toggle("open");
      playlistBtn.classList.toggle("on");
    });
    // 点击迷你条其它区域也展开
    if (miniBar) miniBar.addEventListener("click", function () {
      if (!isCardOpen && !isHidden) setCardOpen(true);
    });

    // ---- 播放模式：列表循环 / 单曲循环 / 随机 ----
    var MODES = ["repeat", "one", "shuffle"];
    var modeLabels = { repeat: "列表循环", one: "单曲循环", shuffle: "随机播放" };
    function modeIcon(m) {
      var sz = 15;
      if (m === "shuffle")
        return '<svg viewBox="0 0 24 24" width="' + sz + '" height="' + sz + '" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5"/><path d="M4 20L21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/></svg>';
      if (m === "one")
        return '<svg viewBox="0 0 24 24" width="' + sz + '" height="' + sz + '" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/><path d="M12 16v-6"/><path d="M10 11l2-2 2 2"/></svg>';
      if (m === "repeat")
        return '<svg viewBox="0 0 24 24" width="' + sz + '" height="' + sz + '" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/></svg>';
      return '<svg viewBox="0 0 24 24" width="' + sz + '" height="' + sz + '" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>';
    }
    var mode = "repeat";
    function setModeIcon() { modeBtn.innerHTML = modeIcon(mode); modeBtn.title = modeLabels[mode]; }
    setModeIcon();

    var playSvg = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l14 9-14 9V3z"/></svg>';
    var pauseSvg = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h4v16H6z"/><path d="M14 4h4v16h-4z"/></svg>';
    var miniPlaySvg = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3l14 9-14 9V3z"/></svg>';
    var miniPauseSvg = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4h4v16H6z"/><path d="M14 4h4v16h-4z"/></svg>';
    function paintPlay() {
      playBtn.innerHTML = audio.paused ? playSvg : pauseSvg;
      miniPlay.innerHTML = audio.paused ? miniPlaySvg : miniPauseSvg;
      if (disc) disc.classList.toggle("playing", !audio.paused);
      if (orb) orb.classList.toggle("playing", !audio.paused);
    }

    function fmt(t) { var s = Math.floor(t || 0); return Math.floor(s / 60) + ":" + ("0" + (s % 60)).slice(-2); }

    function currentIndex() {
      for (var k = 0; k < items.length; k++) if (items[k].classList.contains("on")) return k;
      return -1;
    }

    function setCover(src) {
      if (src) {
        if (coverImg) { coverImg.src = src; coverImg.style.display = "block"; }
        if (miniImg) { miniImg.src = src; miniImg.style.display = "block"; }
        if (orbImg) { orbImg.src = src; orbImg.style.display = "block"; }
        if (miniCover) miniCover.classList.add("has");
      }
    }

    function playAt(i) {
      if (!count) return;
      i = ((i % count) + count) % count;
      var b = items[i]; if (!b) return;
      var url = b.getAttribute("data-url");
      if (!url) { alert("这首歌还没放音频呢~去 config 的 music 填 url 就好♡"); return; }
      title.textContent = b.querySelector(".mp-tx").textContent;
      artist.textContent = b.querySelector(".mp-art2").textContent;
      miniTitle.textContent = b.querySelector(".mp-tx").textContent;
      setCover(b.getAttribute("data-cover"));
      items.forEach(function (x) { x.classList.remove("on"); });
      b.classList.add("on");
      audio.src = url;
      audio.play().catch(function () {});
      paintPlay();
      setSt();
    }

    function step(dir) {
      var idx = currentIndex();
      var nextIdx;
      if (idx === -1) {
        nextIdx = mode === "shuffle" ? Math.floor(Math.random() * count) : 0;
      } else if (mode === "shuffle") {
        nextIdx = Math.floor(Math.random() * count);
      } else if (mode === "one") {
        nextIdx = idx;
      } else {
        nextIdx = idx + dir;
      }
      playAt(nextIdx);
    }

    items.forEach(function (b, i) {
      b.addEventListener("click", function () { playAt(i); });
    });

    prevBtn.addEventListener("click", function () { step(-1); });
    nextBtn.addEventListener("click", function () { step(1); });

    function togglePlay() {
      if (!audio.src) { step(0); return; }
      if (audio.paused) { audio.play().catch(function () {}); } else { audio.pause(); }
      paintPlay();
      setSt();
    }
    playBtn.addEventListener("click", function (e) { e.stopPropagation(); togglePlay(); });
    miniPlay.addEventListener("click", function (e) { e.stopPropagation(); togglePlay(); });

    modeBtn.addEventListener("click", function () {
      mode = MODES[(MODES.indexOf(mode) + 1) % MODES.length];
      setModeIcon();
      setSt();
    });

    // ---- 音量：内联拖动条（指针捕获，可直接拖动）+ 静音 ----
    var volume = 0.8, muted = false;
    function paintVol() {
      volFill.style.width = ((muted ? 0 : volume) * 100) + "%";
    }
    function applyVol() { audio.volume = muted ? 0 : volume; paintVol(); }
    function setVol(v) {
      volume = Math.max(0, Math.min(1, v));
      muted = false;
      applyVol();
      setSt();
    }
    function toggleMute() { muted = !muted; applyVol(); setSt(); }

    if (volBar) {
      function updateVolFromX(e) {
        var r = volBar.getBoundingClientRect();
        if (r.width <= 0) return;
        setVol((e.clientX - r.left) / r.width);
      }
      var draggingId = null;
      function onVolMove(e) { if (draggingId !== null && e.pointerId === draggingId) updateVolFromX(e); }
      function onVolUp(e) {
        if (draggingId !== null && e.pointerId === draggingId) {
          volBar.releasePointerCapture(draggingId);
          draggingId = null;
          volBar.removeEventListener("pointermove", onVolMove);
          volBar.removeEventListener("pointerup", onVolUp);
          volBar.removeEventListener("pointercancel", onVolUp);
        }
      }
      volBar.addEventListener("pointerdown", function (e) {
        e.preventDefault();
        updateVolFromX(e);
        draggingId = e.pointerId;
        volBar.setPointerCapture(draggingId);
        volBar.addEventListener("pointermove", onVolMove);
        volBar.addEventListener("pointerup", onVolUp);
        volBar.addEventListener("pointercancel", onVolUp);
      });
      applyVol();
    }

    // ---- 收起判定（防御版）：记录「按下」点是否在卡片区域内~♡
    // 点播放/切歌时图标会被 innerHTML 替换，click 的 target 可能脱树，
    // 靠 pointerdown 记一次布尔，就能保证点播放绝不会误收卡片。 --------
    var pressedInside = false;
    document.addEventListener("pointerdown", function (e) {
      pressedInside = root.contains(e.target);
    });
    document.addEventListener("click", function (e) {
      if (volBar && volBar.contains(e.target)) return;
      if (list && list.contains(e.target)) return;
      if (isCardOpen && card.contains(e.target)) return;
      if (isCardOpen && pressedInside) { pressedInside = false; return; }
      if (isCardOpen && !root.contains(e.target)) setCardOpen(false);
    });

    // ---- 键盘快捷键：空格播放/暂停 · M 静音 · 方向键音量 ----
    function isEditable(el) {
      if (!el) return false;
      if (el.tagName === "INPUT" || el.tagName === "TEXTAREA") return true;
      return el.getAttribute && el.getAttribute("contenteditable") === "true";
    }
    function handleKeyDown(e) {
      if (!document.body.contains(root)) return;
      if (isEditable(e.target)) return;
      if (e.code === "Space") { e.preventDefault(); togglePlay(); }
      else if (e.key === "m" || e.key === "M") { toggleMute(); }
      else if (e.key === "ArrowRight" || e.key === "ArrowUp") { e.preventDefault(); setVol(volume + 0.05); }
      else if (e.key === "ArrowLeft" || e.key === "ArrowDown") { e.preventDefault(); setVol(volume - 0.05); }
    }
    window.addEventListener("keydown", handleKeyDown);

    // ---- 进度 / 时间 ----
    audio.addEventListener("timeupdate", function () {
      var t = audio.currentTime || 0, d = audio.duration || 0;
      cur.textContent = fmt(t);
      dur.textContent = fmt(d);
      fill.style.width = (d ? (t / d) * 100 : 0) + "%";
    });
    audio.addEventListener("loadedmetadata", function () { dur.textContent = fmt(audio.duration); });

    if (prog) prog.addEventListener("click", function (e) {
      var r = prog.getBoundingClientRect();
      var x = (e.clientX - r.left) / r.width;
      if (audio.duration) audio.currentTime = x * audio.duration;
    });

    // ---- 播放结束：按模式切歌 ----
    audio.addEventListener("ended", function () {
      if (mode === "one") playAt(currentIndex());
      else if (mode === "repeat") playAt(currentIndex() + 1);
      else step(1);
    });
    }   // ← 事件绑定守卫结束（首次挂载才注册，跨页只同步显示）

    // ---- 跨页恢复显示状态（View Transitions 后同步过来~♡）----
    var st = getSt();
    if (typeof st.mode === "string") { mode = st.mode; setModeIcon(); }
    if (typeof st.vol === "number") { volume = st.vol; muted = !!st.muted; applyVol(); }
    var si = st.i;
    if (typeof si === "number" && si >= 0 && items[si]) {
      items.forEach(function (x) { x.classList.remove("on"); });
      items[si].classList.add("on");
      var b = items[si];
      title.textContent = b.querySelector(".mp-tx").textContent;
      artist.textContent = b.querySelector(".mp-art2").textContent;
      miniTitle.textContent = b.querySelector(".mp-tx").textContent;
      setCover(b.getAttribute("data-cover"));
    }
    // 若音频还在（persist）且还没到保存点，把进度归位
    if (audio && audio.src && st.t && audio.readyState > 0 && Math.abs(audio.currentTime) < 0.5) {
      try { audio.currentTime = st.t; } catch (e) {}
    }
    paintPlay();
  })();
</script>

