---
// ============================================================
//  📄 分页条 (Pager) — 1234 那种页码，放列表页底部
// ------------------------------------------------------------
//  用法：<Pager current={page.currentPage} last={page.lastPage}
//               base="/articles/" total={page.total} />
//  · base 是第 1 页的地址，第 n 页 = base + n + "/"
//  · 页码太多时自动省略中间（1 … 4 5 6 … 12）
//  · 当前页高亮，首尾箭头自动禁用
// ============================================================
interface Props {
  current: number;
  last: number;
  base: string;
  total?: number;
  label?: string;
}
const { current, last, base, total, label = "分页" } = Astro.props;

const hrefOf = (n: number) => (n <= 1 ? base : base + n + "/");

// 生成要显示的页码：页数少就全显示，多了就留 1 / 当前±1 / 末页，中间用省略号
const nums: (number | "gap")[] = [];
if (last <= 7) {
  for (let i = 1; i <= last; i++) nums.push(i);
} else {
  const pick = new Set<number>([1, last]);
  for (let i = current - 1; i <= current + 1; i++) if (i >= 1 && i <= last) pick.add(i);
  if (current <= 4) { pick.add(2); pick.add(3); pick.add(4); pick.add(5); }
  if (current >= last - 3) { for (let i = last - 4; i <= last; i++) if (i >= 1) pick.add(i); }
  const sorted = [...pick].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
  sorted.forEach((n, i) => {
    if (i > 0 && n - sorted[i - 1] > 1) nums.push("gap");
    nums.push(n);
  });
}
---
<nav class="pager" aria-label={label}>
  {current > 1 ? (
    <a class="pg-arrow" href={hrefOf(current - 1)} rel="prev" aria-label="上一页">‹</a>
  ) : (
    <span class="pg-arrow pg-off" aria-hidden="true">‹</span>
  )}

  <span class="pg-nums">
    {nums.map((n) =>
      n === "gap" ? (
        <span class="pg-gap" aria-hidden="true">…</span>
      ) : n === current ? (
        <span class="pg-num on" aria-current="page">{n}</span>
      ) : (
        <a class="pg-num" href={hrefOf(n)} aria-label={"第 " + n + " 页"}>{n}</a>
      )
    )}
  </span>

  {current < last ? (
    <a class="pg-arrow" href={hrefOf(current + 1)} rel="next" aria-label="下一页">›</a>
  ) : (
    <span class="pg-arrow pg-off" aria-hidden="true">›</span>
  )}

  {total ? <span class="pg-total">共 {total} 篇</span> : null}
</nav>

<style>
  .pager {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin: 22px 0 6px;
    flex-wrap: wrap;
  }
  .pg-nums { display: flex; align-items: center; gap: 6px; }

  .pg-num,
  .pg-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    height: 32px;
    padding: 0 9px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--card-bg) 70%, transparent);
    color: var(--text-dim);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    transition: color .18s ease, border-color .18s ease, background .18s ease, transform .18s ease;
  }
  .pg-arrow { font-size: 15px; line-height: 1; }
  .pg-num:hover,
  .pg-arrow:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    text-decoration: none;
    transform: translateY(-1px);
  }
  .pg-num.on {
    color: #fff;
    border-color: transparent;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    box-shadow: 0 6px 14px color-mix(in srgb, var(--accent) 28%, transparent);
    font-weight: 700;
  }
  .pg-off { opacity: .38; pointer-events: none; }
  .pg-gap { color: var(--text-dim); font-size: 12px; padding: 0 2px; }
  .pg-total {
    margin-left: 4px;
    font-size: 11.5px;
    color: var(--text-dim);
  }

  @media (max-width: 480px) {
    .pg-num, .pg-arrow { min-width: 29px; height: 29px; padding: 0 7px; font-size: 12px; }
    .pg-total { flex-basis: 100%; text-align: center; margin: 2px 0 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pg-num, .pg-arrow { transition: none; }
  }
</style>
