---
// ============================================================
//  🎀 Live2D 看板娘（Mizuki 同款：iframe + Live2DWidget）
// ------------------------------------------------------------
//  🧱 结构：
//     #l2d-root
//       ├─ .l2d-bubble        主页面自己画的气泡（Live2D.say 用）
//       └─ iframe[data-src]   真正的 Live2D 跑在里面（/live2d/host.html）
//
//  ✅ 为什么用 iframe：
//     · widget 的 canvas / 菜单 / 提示气泡跟站点 CSS 完全隔离
//     · 切页（View Transitions）不会把 canvas 撕掉，也不会重复初始化
//
//  ✅ 懒加载：iframe 先不写 src，主页面空闲了才塞进去，首屏不背 660KB
//  ✅ 手机端：hiddenOnMobile 时连 iframe 都不加载
//  ✅ 想改东西 → 只改 src/config/live2d.ts（模型/大小/菜单位置都在那）
// ============================================================
import { live2dConfig as cfg } from "../config/live2d";

const base = import.meta.env.BASE_URL;
const prefix = base.endsWith("/") ? base : base + "/";
const hostSrc = prefix + "live2d/host.html";

const vars = [
  "--l2d-w:" + cfg.size + "px",
  "--l2d-h:" + (cfg.size + cfg.extraHeight) + "px",
  "--l2d-extra:" + cfg.extraHeight + "px",
  "--l2d-x:" + cfg.offsetX + "px",
  "--l2d-y:" + cfg.offsetY + "px",
  "--l2d-z:" + cfg.zIndex,
].join(";");
---

{cfg.enabled && (
  <div
    id="l2d-root"
    class="l2d-root"
    data-side={cfg.position === "bottom-right" ? "right" : "left"}
    data-off="1"
    style={vars}
    transition:persist
  >
    <!-- 💬 主页面气泡：window.Live2D.say("...") 写这里（widget 自己的 tips 在 iframe 里） -->
    <div class="l2d-bubble" id="l2d-bubble"></div>

    <!-- 🎨 Live2D 本体：src 由 driver 在空闲时塞进去 -->
    <iframe
      id="l2d-frame"
      class="l2d-frame"
      title="看板娘：NOIR"
      data-src={hostSrc}
      scrolling="no"
      allowtransparency="true"
      tabindex="-1"
    ></iframe>
  </div>
)}

<!-- 📱 手机上不显示：CSS 兜底，JS 没跑也不会糊在小屏上~♡ -->
{cfg.enabled && cfg.hiddenOnMobile && (
  <style is:inline>{'@media (max-width:' + cfg.breakpoint + 'px){#l2d-root{display:none!important}}'}</style>
)}

<script>
  import { mountLive2D } from "../lib/live2d/driver";
  mountLive2D();
</script>

<style>
  /* ===== 外壳：贴边悬浮，自己不吃鼠标事件 ===== */
  :global(.l2d-root) {
    position: fixed;
    bottom: var(--l2d-y, 76px);
    width: var(--l2d-w, 280px);
    height: var(--l2d-h, 364px);
    z-index: var(--l2d-z, 900);
    pointer-events: none;
    user-select: none;
    -webkit-user-select: none;
  }
  :global(.l2d-root[data-side="right"]) { right: var(--l2d-x, 8px); }
  :global(.l2d-root[data-side="left"])  { left: var(--l2d-x, 8px); }
  :global(.l2d-root[data-off="1"]) { display: none; }

  /* ===== iframe：加载完才显形、才开始吃事件 ===== */
  :global(.l2d-frame) {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    opacity: 0;
    pointer-events: none;
    transition: opacity .6s ease;
  }
  :global(.l2d-frame.is-ready) {
    opacity: 1;
    pointer-events: auto;
  }

  /* ===== 主页面气泡（在模型头顶那一截留白里） ===== */
  :global(.l2d-bubble) {
    position: absolute;
    /* 用百分比挂到「头顶略上方」：根容器高度 = (size+extraHeight)×缩放，
       所以 56% 在任何断点都落在脑袋上面一点点，不会随缩放飘走~♡ */
    top: auto;
    bottom: 56%;
    right: 4px;
    max-width: 220px;
    padding: 9px 13px;
    border-radius: 14px;
    font-size: 13px;
    line-height: 1.55;
    text-align: left;
    white-space: pre-wrap;
    color: var(--text, #4a4560);
    background: var(--panel, rgba(255, 255, 255, .94));
    border: 1px solid var(--border, rgba(0, 0, 0, .08));
    box-shadow: 0 10px 26px rgba(0, 0, 0, .14);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    pointer-events: none;
    transition: opacity .25s ease, transform .25s ease, visibility .25s;
    z-index: 2;
  }
  :global(.l2d-bubble.is-on) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  :global(.l2d-bubble::after) {
    content: "";
    position: absolute;
    right: 52%;
    bottom: -5px;
    width: 9px;
    height: 9px;
    background: var(--panel, rgba(255, 255, 255, .94));
    border-right: 1px solid var(--border, rgba(0, 0, 0, .08));
    border-bottom: 1px solid var(--border, rgba(0, 0, 0, .08));
    transform: rotate(45deg);
    border-radius: 0 0 2px 0;
  }

  /* ===== 窄屏：整只等比缩小，别压到左侧栏；再窄就干脆不显示 =====
     站点是「左栏 + 正文 + 右栏」的三栏布局，看板娘固定在左下角，
     视口不够宽时会盖住侧栏链接，所以按宽度分三档处理~♡ */
  @media (max-width: 1750px) {
    :global(#l2d-root) { transform: scale(.85); transform-origin: bottom left; }
  }
  @media (max-width: 1500px) {
    :global(#l2d-root) { transform: scale(.72); }
  }
  @media (max-width: 1280px) {
    :global(#l2d-root) { display: none !important; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.l2d-frame), :global(.l2d-bubble) { transition-duration: .15s; }
  }
</style>
